@model IEnumerable<TechStore.Models.Ventum>

@{
    ViewData["Title"] = "Mis compras";
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Mis compras - TechStore</title>

    <script src="https://cdn.tailwindcss.com"></script>

</head>

<body class="bg-slate-100 min-h-screen">

    <!-- ===================================================== -->
    <!-- CONTENEDOR PRINCIPAL -->
    <!-- ===================================================== -->

    <div class="min-h-screen bg-slate-100">

        <main class="max-w-7xl mx-auto px-6 py-8">


            <!-- ================================================= -->
            <!-- ENCABEZADO -->
            <!-- ================================================= -->

            <div class="bg-white rounded-xl shadow-sm p-6 mb-6">

                <div class="flex flex-col md:flex-row
                    md:items-center
                    md:justify-between
                    gap-4">

                    <div>

                        <h1 class="text-2xl font-bold text-slate-900">
                            Mis compras
                        </h1>

                        <p class="text-slate-500 mt-1">
                            Aquí puedes consultar todas las compras
                            que has realizado.
                        </p>

                    </div>


                    <!-- ================================================= -->
                    <!-- BOTONES -->
                    <!-- ================================================= -->

                    <div class="flex flex-wrap gap-2">

                        <a href="/Cliente/Catalogo"
                           class="bg-indigo-600
                            text-white
                            px-5
                            py-2.5
                            rounded-lg
                            shadow-sm
                            hover:bg-indigo-700
                            transition">

                            Seguir comprando

                        </a>


                        <a href="/Carrito/Index"
                           class="border
                            border-indigo-600
                            text-indigo-600
                            px-5
                            py-2.5
                            rounded-lg
                            hover:bg-indigo-50
                            transition">

                            🛒 Carrito

                        </a>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- MENSAJE DE ÉXITO -->
            <!-- ================================================= -->
            @if (TempData["Success"] != null)
            {
                <div class="mb-6
                    bg-green-50
                    border
                    border-green-200
                    text-green-700
                    px-5
                    py-4
                    rounded-xl">

                    <div class="flex items-center gap-2">

                        <span class="text-lg">
                            ✓
                        </span>

                        <div>

                            <strong class="font-semibold">
                                ¡Éxito!
                            </strong>

                            <span class="ml-1">
                                @TempData["Success"]
                            </span>

                        </div>

                    </div>

                </div>
            }


            <!-- ================================================= -->
            <!-- MENSAJE DE ERROR -->
            <!-- ================================================= -->
            @if (TempData["Error"] != null)
            {
                <div class="mb-6
                    bg-red-50
                    border
                    border-red-200
                    text-red-700
                    px-5
                    py-4
                    rounded-xl">

                    <div class="flex items-center gap-2">

                        <span class="text-lg">
                            ⚠
                        </span>

                        <div>

                            <strong class="font-semibold">
                                Error:
                            </strong>

                            <span class="ml-1">
                                @TempData["Error"]
                            </span>

                        </div>

                    </div>

                </div>
            }


            <!-- ================================================= -->
            <!-- NO HAY COMPRAS -->
            <!-- ================================================= -->
            @if (Model == null || !Model.Any())
            {
                <div class="bg-white
                    rounded-xl
                    shadow-sm
                    border
                    border-slate-200">

                    <div class="text-center py-16 px-6">

                        <div class="text-6xl mb-5">
                            🛒
                        </div>

                        <h2 class="text-xl
                            font-bold
                            text-slate-800">

                            Todavía no tienes compras

                        </h2>

                        <p class="text-slate-500 mt-2 mb-6">

                            Cuando realices una compra,
                            aparecerá aquí.

                        </p>


                        <a href="/Cliente/Catalogo"
                           class="inline-block
                            bg-indigo-600
                            text-white
                            px-6
                            py-3
                            rounded-lg
                            shadow-sm
                            hover:bg-indigo-700
                            transition">

                            Ver productos

                        </a>

                    </div>

                </div>
            }
            else
            {

                <!-- ================================================= -->
                <!-- HISTORIAL DE COMPRAS -->
                <!-- ================================================= -->

                <div class="bg-white
                    rounded-xl
                    shadow-sm
                    border
                    border-slate-200
                    overflow-hidden">


                    <!-- ================================================= -->
                    <!-- CABECERA -->
                    <!-- ================================================= -->

                    <div class="px-6
                        py-5
                        border-b
                        border-slate-200">

                        <h2 class="text-lg
                            font-bold
                            text-slate-900">

                            Historial de compras

                        </h2>

                        <p class="text-sm
                            text-slate-500
                            mt-1">

                            Consulta el estado y total
                            de tus compras realizadas.

                        </p>

                    </div>


                    <!-- ================================================= -->
                    <!-- TABLA -->
                    <!-- ================================================= -->

                    <div class="overflow-x-auto">

                        <table class="w-full">

                            <thead>

                                <tr class="bg-slate-900
                                    text-white">

                                    <th class="text-left
                                        py-4
                                        px-6
                                        text-sm
                                        font-semibold">

                                        Venta

                                    </th>


                                    <th class="text-left
                                        py-4
                                        px-6
                                        text-sm
                                        font-semibold">

                                        Fecha

                                    </th>


                                    <th class="text-left
                                        py-4
                                        px-6
                                        text-sm
                                        font-semibold">

                                        Total

                                    </th>


                                    <th class="text-left
                                        py-4
                                        px-6
                                        text-sm
                                        font-semibold">

                                        Estado

                                    </th>

                                </tr>

                            </thead>


                            <tbody class="divide-y
                                divide-slate-100">

                                @foreach (var venta in Model)
                                {
                                    <tr class="hover:bg-slate-50
                                        transition">


                                        <!-- ========================= -->
                                        <!-- ID VENTA -->
                                        <!-- ========================= -->

                                        <td class="py-4 px-6">

                                            <span class="font-bold
                                                text-slate-900">

                                                #@venta.IdVenta

                                            </span>

                                        </td>


                                        <!-- ========================= -->
                                        <!-- FECHA -->
                                        <!-- ========================= -->

                                        <td class="py-4 px-6">

                                            <span class="text-slate-700">

                                                @venta.Fecha.ToString(
                                                    "dd/MM/yyyy HH:mm"
                                                )

                                            </span>

                                        </td>


                                        <!-- ========================= -->
                                        <!-- TOTAL -->
                                        <!-- ========================= -->

                                        <td class="py-4 px-6">

                                            <span class="font-bold
                                                text-slate-900">

                                                ₡@((venta.Total ?? 0).ToString("N2"))

                                            </span>

                                        </td>


                                        <!-- ========================= -->
                                        <!-- ESTADO -->
                                        <!-- ========================= -->

                                        <td class="py-4 px-6">

                                            @if (venta.Estado == "Pendiente")
                                            {
                                                <span class="inline-flex
                                                    items-center
                                                    px-3
                                                    py-1
                                                    rounded-full
                                                    text-sm
                                                    font-medium
                                                    bg-yellow-100
                                                    text-yellow-700">

                                                    Pendiente

                                                </span>
                                            }
                                            else if (venta.Estado == "Completada")
                                            {
                                                <span class="inline-flex
                                                    items-center
                                                    px-3
                                                    py-1
                                                    rounded-full
                                                    text-sm
                                                    font-medium
                                                    bg-green-100
                                                    text-green-700">

                                                    Completada

                                                </span>
                                            }
                                            else if (venta.Estado == "Cancelada")
                                            {
                                                <span class="inline-flex
                                                    items-center
                                                    px-3
                                                    py-1
                                                    rounded-full
                                                    text-sm
                                                    font-medium
                                                    bg-red-100
                                                    text-red-700">

                                                    Cancelada

                                                </span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex
                                                    items-center
                                                    px-3
                                                    py-1
                                                    rounded-full
                                                    text-sm
                                                    font-medium
                                                    bg-slate-100
                                                    text-slate-700">

                                                    @venta.Estado

                                                </span>
                                            }

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            }

        </main>

    </div>

</body>

</html>