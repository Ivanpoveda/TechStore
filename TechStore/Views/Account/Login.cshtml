@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <!-- ✅ Aquí la ruta correcta -->
    <link rel="stylesheet" href="~/css/styles.css" />
</head>
<body>
    <div class="login-wrapper">
        <div class="login-card">
            <h2>Bienvenido a TechStore</h2>
            <p>Ingresa tus credenciales para acceder</p>

            <form asp-action="Login" method="post" class="login-form">
                <label for="correo">Correo Electrónico</label>
                <input type="email" id="correo" name="correo" placeholder="usuario@ejemplo.com" required />

                <label for="contrasenia">Contraseña</label>
                <input type="password" id="contrasenia" name="contrasenia" placeholder="••••••••" required />
                <a href="#">¿Olvidaste tu clave?</a>

                <div class="remember">
                    <input type="checkbox" id="recordar" />
                    <label for="recordar">Recordar este dispositivo</label>
                </div>

                <button type="submit">Iniciar Sesión</button>
            </form>

            <p class="register">¿No tienes una cuenta? <a href="#">Regístrate aquí</a></p>
        </div>
    </div>
</body>
</html>
