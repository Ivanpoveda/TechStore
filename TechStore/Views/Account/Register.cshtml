@{
    ViewData["Title"] = "Registro";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - TechStore</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="container">
        <div class="login-card">
            <div class="login-icon">
                <i class="bi bi-person-plus-fill"></i>
            </div>

            <h2>Crear cuenta</h2>
            <p>Completa tus datos para registrarte</p>

            <form asp-action="Register" method="post" class="login-form">
                <div class="form-group">
                    <label for="Nombre">Nombre</label>
                    <input type="text" id="Nombre" name="Nombre" placeholder="Ingrese su nombre" required />
                </div>

                <div class="form-group">
                    <label for="Apellidos">Apellidos</label>
                    <input type="text" id="Apellidos" name="Apellidos" placeholder="Ingrese sus apellidos" required />
                </div>

                <div class="form-group">
                    <label for="Correo">Correo Electrónico</label>
                    <input type="email" id="Correo" name="Correo" placeholder="usuario@ejemplo.com" required />
                </div>

                <div class="form-group">
                    <label for="Contrasenia">Contraseña</label>
                    <input type="password" id="Contrasenia" name="Contrasenia" placeholder="••••••••" required />
                </div>

                <div class="form-group">
                    <label for="Telefono">Teléfono</label>
                    <input type="text" id="Telefono" name="Telefono" placeholder="0000-0000" />
                </div>

                <button type="submit">Registrarse</button>
            </form>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger mt-3">
                    @ViewBag.Error
                </div>
            }

            <p class="register">
                ¿Ya tienes cuenta?
                <a asp-action="Login" asp-controller="Account">Inicia sesión aquí</a>
            </p>
        </div>
    </div>
</body>
</html>

