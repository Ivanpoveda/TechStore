@{
    ViewData["Title"] = "Registro";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - TechStore
    </title>

    <script src="https://cdn.tailwindcss.com"></script>

</head>

<body class="min-h-screen bg-slate-50 flex items-center justify-center p-6">

    <div class="w-full max-w-lg">

        <div class="bg-white rounded-2xl shadow-lg
            border border-slate-200 p-8">

            <!-- LOGO -->

            <div class="flex justify-center mb-6">

                <div class="w-14 h-14
                    bg-indigo-500
                    rounded-xl
                    flex items-center justify-center
                    text-white
                    text-xl
                    font-bold">

                    TS

                </div>

            </div>


            <!-- TITULO -->

            <div class="text-center mb-8">

                <h1 class="text-2xl font-bold text-slate-900">

                    Registro de Usuario

                </h1>

                <p class="text-slate-500 mt-2">

                    Completa tus datos para registrarte

                </p>

            </div>


            <!-- FORMULARIO -->

            <form asp-action="Register"
                  asp-controller="Account"
                  method="post"
                  class="space-y-5">

                @Html.AntiForgeryToken()


                <!-- NOMBRE -->

                <div>

                    <label for="Nombre"
                           class="block text-sm
                        font-semibold
                        text-slate-700
                        mb-2">

                        Nombre

                    </label>

                    <input type="text"
                           id="Nombre"
                           name="Nombre"
                           placeholder="Ingrese su nombre"
                           required
                           class="w-full px-4 py-3
                    border border-slate-300
                    rounded-lg
                    text-slate-900
                    placeholder-slate-400
                    focus:outline-none
                    focus:ring-2
                    focus:ring-indigo-500
                    focus:border-indigo-500" />

                </div>


                <!-- APELLIDOS -->

                <div>

                    <label for="Apellidos"
                           class="block text-sm
                        font-semibold
                        text-slate-700
                        mb-2">

                        Apellidos

                    </label>

                    <input type="text"
                           id="Apellidos"
                           name="Apellidos"
                           placeholder="Ingrese sus apellidos"
                           required
                           class="w-full px-4 py-3
                    border border-slate-300
                    rounded-lg
                    text-slate-900
                    placeholder-slate-400
                    focus:outline-none
                    focus:ring-2
                    focus:ring-indigo-500
                    focus:border-indigo-500" />

                </div>


                <!-- CORREO -->

                <div>

                    <label for="Correo"
                           class="block text-sm
                        font-semibold
                        text-slate-700
                        mb-2">

                        Correo electrónico

                    </label>

                    <input type="email"
                           id="Correo"
                           name="Correo"
                           placeholder="usuario@ejemplo.com"
                           required
                           class="w-full px-4 py-3
                    border border-slate-300
                    rounded-lg
                    text-slate-900
                    placeholder-slate-400
                    focus:outline-none
                    focus:ring-2
                    focus:ring-indigo-500
                    focus:border-indigo-500" />

                </div>


                <!-- CONTRASEÑA -->

                <div>

                    <label for="Contrasenia"
                           class="block text-sm
                        font-semibold
                        text-slate-700
                        mb-2">

                        Contraseña

                    </label>

                    <input type="password"
                           id="Contrasenia"
                           name="Contrasenia"
                           placeholder="••••••••"
                           required
                           class="w-full px-4 py-3
                    border border-slate-300
                    rounded-lg
                    text-slate-900
                    placeholder-slate-400
                    focus:outline-none
                    focus:ring-2
                    focus:ring-indigo-500
                    focus:border-indigo-500" />

                </div>


                <!-- TELEFONO -->

                <div>

                    <label for="Telefono"
                           class="block text-sm
                        font-semibold
                        text-slate-700
                        mb-2">

                        Teléfono

                    </label>

                    <input type="text"
                           id="Telefono"
                           name="Telefono"
                           placeholder="0000-0000"
                           class="w-full px-4 py-3
                    border border-slate-300
                    rounded-lg
                    text-slate-900
                    placeholder-slate-400
                    focus:outline-none
                    focus:ring-2
                    focus:ring-indigo-500
                    focus:border-indigo-500" />

                </div>


                <!-- ERROR -->
                @if (ViewBag.Error != null)
                {

                    <div class="p-4
                        rounded-lg
                        bg-red-50
                        border border-red-200
                        text-red-700
                        text-sm">

                        @ViewBag.Error

                    </div>

                }


                <!-- BOTON -->

                <button type="submit"
                        class="w-full
                    bg-indigo-600
                    text-white
                    font-semibold
                    py-3
                    rounded-lg
                    shadow-sm
                    hover:bg-indigo-700
                    transition">

                    Registrarse

                </button>

            </form>


            <!-- LOGIN -->

            <div class="text-center mt-6 pt-6
                border-t border-slate-200">

                <p class="text-sm text-slate-500">

                    ¿Ya tienes una cuenta?

                    <a href="Login/Account"
                       class="font-semibold
                        text-indigo-600
                        hover:text-indigo-700">

                        Inicia sesión aquí

                    </a>

                </p>

            </div>

        </div>


        <!-- MARCA -->

        <div class="text-center mt-6">

            <div class="inline-flex
                items-center
                gap-2">

                <div class="w-8 h-8
                    bg-indigo-500
                    rounded-lg
                    flex items-center justify-center
                    text-white
                    font-bold">

                    TS

                </div>

                <span class="font-bold text-slate-700">

                    TechStore

                </span>

            </div>

        </div>

    </div>

</body>

</html>
