@model TechStore.Models.Proveedor

@{
    ViewData["Title"] = "Eliminar Proveedor";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - TechStore</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-100 min-h-screen">

    <div class="min-h-screen bg-slate-100 flex flex-col md:flex-row">

        ```
        <aside class="w-full md:w-64 bg-slate-900 text-white p-5 shrink-0">

            <div class="flex items-center gap-3 mb-8">

                <div class="w-8 h-8 bg-indigo-500 rounded-lg flex items-center justify-center font-bold">
                    TS
                </div>

                <span class="font-bold text-lg">
                    TechStore Admin
                </span>

            </div>

            <nav class="space-y-1">

                <a href="/Admin/Dashboard"
                   class="block px-4 py-2.5 rounded-lg text-slate-400 hover:bg-indigo-600 hover:text-white transition">
                    Dashboard
                </a>

                <a href="/Usuario/Index"
                   class="block px-4 py-2.5 rounded-lg text-slate-400 hover:bg-indigo-600 hover:text-white transition">
                    Usuarios
                </a>

                <a href="/Producto/Index"
                   class="block px-4 py-2.5 rounded-lg text-slate-400 hover:bg-indigo-600 hover:text-white transition">
                    Productos
                </a>

                <a href="/Venta/Index"
                   class="block px-4 py-2.5 rounded-lg text-slate-400 hover:bg-indigo-600 hover:text-white transition">
                    Ventas
                </a>

                <a href="/Garantia/Index"
                   class="block px-4 py-2.5 rounded-lg text-slate-400 hover:bg-indigo-600 hover:text-white transition">
                    Garantías
                </a>

                <a href="/Proveedor/Index"
                   class="block px-4 py-2.5 rounded-lg bg-indigo-600 text-white">
                    Proveedores
                </a>

            </nav>

        </aside>


        <main class="flex-1 p-6">

            <div class="max-w-xl mx-auto">

                <div class="bg-white rounded-xl shadow p-6">

                    <div class="text-center">

                        <div class="w-14 h-14 mx-auto rounded-full
                            bg-red-100 text-red-600
                            flex items-center justify-center
                            text-2xl mb-4">
                            !
                        </div>

                        <h1 class="text-2xl font-bold text-slate-900">
                            Eliminar Proveedor
                        </h1>

                        <p class="text-slate-500 mt-2">
                            ¿Estás seguro de que deseas eliminar este proveedor?
                        </p>

                    </div>


                    <div class="bg-slate-50 rounded-lg p-5 mt-6">

                        <div class="mb-4">

                            <p class="text-sm text-slate-500">
                                Nombre
                            </p>

                            <p class="font-semibold text-slate-900">
                                @Model.Nombre
                            </p>

                        </div>


                        <div class="mb-4">

                            <p class="text-sm text-slate-500">
                                Empresa
                            </p>

                            <p class="font-semibold text-slate-900">
                                @(Model.Empresa ?? "—")
                            </p>

                        </div>


                        <div>

                            <p class="text-sm text-slate-500">
                                Correo
                            </p>

                            <p class="font-semibold text-slate-900">
                                @(Model.Correo ?? "—")
                            </p>

                        </div>

                    </div>


                    <div class="bg-red-50 border border-red-200
                        text-red-700 rounded-lg p-4 mt-5 text-sm">

                        Esta acción eliminará permanentemente el proveedor.
                        Si el proveedor tiene registros relacionados en
                        compras, SQL Server podría impedir la eliminación.

                    </div>


                    <form asp-action="Delete" method="post"
                          class="flex justify-end gap-3 mt-6">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="IdProveedor" />

                        <a href="/Proveedor/Index"
                           class="px-5 py-2.5 rounded-lg
                            border border-slate-300
                            text-slate-600 hover:bg-slate-100 transition">

                            Cancelar

                        </a>

                        <button type="submit"
                                class="bg-red-600 text-white
                            px-5 py-2.5 rounded-lg
                            shadow hover:bg-red-700 transition">

                            Sí, Eliminar

                        </button>

                    </form>

                </div>

            </div>

        </main>
    </div>

</body>
</html>
