@model IEnumerable<TechStore.Models.Proveedor>

@{
    ViewData["Title"] = "Proveedores";
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - TechStore</title>

    <script src="https://cdn.tailwindcss.com"></script>

</head>

<body class="bg-slate-100 min-h-screen">

    <div class="min-h-screen bg-slate-100 flex flex-col md:flex-row">

        <!-- ===================================================== -->
        <!-- SIDEBAR -->
        <!-- ===================================================== -->

        <aside class="w-full md:w-64 bg-slate-900 text-white p-5 shrink-0 flex flex-col">

            <!-- LOGO -->

            <div class="flex items-center gap-3 mb-8">

                <div class="w-8 h-8 bg-indigo-500 rounded-lg
                    flex items-center justify-center font-bold">
                    TS
                </div>

                <span class="font-bold text-lg">
                    TechStore Admin
                </span>

            </div>


            <!-- MENU -->

            <nav class="space-y-1 flex-1">

                <a href="/Admin/Dashboard"
                   class="block px-4 py-2.5 rounded-lg
                    text-slate-400
                    hover:bg-indigo-600
                    hover:text-white
                    transition">

                    Dashboard

                </a>


                <a href="/Usuario/Index"
                   class="block px-4 py-2.5 rounded-lg
                    text-slate-400
                    hover:bg-indigo-600
                    hover:text-white
                    transition">

                    Usuarios

                </a>


                <a href="/Producto/Index"
                   class="block px-4 py-2.5 rounded-lg
                    text-slate-400
                    hover:bg-indigo-600
                    hover:text-white
                    transition">

                    Productos

                </a>


                <a href="/Venta/Index"
                   class="block px-4 py-2.5 rounded-lg
                    text-slate-400
                    hover:bg-indigo-600
                    hover:text-white
                    transition">

                    Ventas

                </a>


                <a href="/Garantia/Index"
                   class="block px-4 py-2.5 rounded-lg
                    text-slate-400
                    hover:bg-indigo-600
                    hover:text-white
                    transition">

                    Garantías

                </a>


                <!-- PROVEEDORES -->

                <a href="/Proveedor/Index"
                   class="block px-4 py-2.5 rounded-lg
                    bg-indigo-600
                    text-white">

                    Proveedores

                </a>


                <!-- COMPRAS A PROVEEDORES -->

                <a href="/CompraProveedor/Index"
                   class="block px-4 py-2.5 rounded-lg
                    text-slate-400
                    hover:bg-indigo-600
                    hover:text-white
                    transition">

                    Compras a proveedores

                </a>

            </nav>


            <!-- LOGOUT -->

            <div class="border-t border-slate-700 pt-4 mt-6">

                <form action="/Account/Logout"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="w-full flex items-center gap-3
                        px-4 py-2.5 rounded-lg
                        text-slate-400
                        hover:bg-red-600
                        hover:text-white
                        transition">

                        <span class="text-lg">
                            ⇥
                        </span>

                        <span>
                            Cerrar sesión
                        </span>

                    </button>

                </form>

            </div>

        </aside>


        <!-- ===================================================== -->
        <!-- CONTENIDO -->
        <!-- ===================================================== -->

        <main class="flex-1 p-6">

            <div class="max-w-7xl mx-auto">


                <!-- ================================================= -->
                <!-- ENCABEZADO -->
                <!-- ================================================= -->

                <div class="flex flex-col md:flex-row
                    md:items-center
                    md:justify-between
                    gap-4
                    mb-6">

                    <div>

                        <h1 class="text-2xl font-bold text-slate-900">
                            Proveedores
                        </h1>

                        <p class="text-slate-500 mt-1">
                            Gestiona los proveedores de TechStore.
                        </p>

                    </div>


                    <div class="flex flex-col sm:flex-row gap-3">

                        <!-- NUEVO PROVEEDOR -->

                        <a href="/Proveedor/Create"
                           class="inline-flex
                            items-center
                            justify-center
                            bg-indigo-600
                            text-white
                            px-5 py-2.5
                            rounded-lg
                            shadow
                            hover:bg-indigo-700
                            transition">

                            + Nuevo Proveedor

                        </a>


                        <!-- COMPRAS A PROVEEDORES -->

                        <a href="/CompraProveedor/Index"
                           class="inline-flex
                            items-center
                            justify-center
                            bg-emerald-600
                            text-white
                            px-5 py-2.5
                            rounded-lg
                            shadow
                            hover:bg-emerald-700
                            transition">

                            🛒 Compras a proveedores

                        </a>

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- MENSAJES -->
                <!-- ================================================= -->
                @if (TempData["Success"] != null)
                {
                    <div class="mb-5
                        bg-green-50
                        border border-green-200
                        text-green-700
                        px-4 py-3
                        rounded-lg">

                        @TempData["Success"]

                    </div>
                }


                @if (TempData["Error"] != null)
                {
                    <div class="mb-5
                        bg-red-50
                        border border-red-200
                        text-red-700
                        px-4 py-3
                        rounded-lg">

                        @TempData["Error"]

                    </div>
                }


                <!-- ================================================= -->
                <!-- TABLA -->
                <!-- ================================================= -->

                <div class="bg-white
                    rounded-xl
                    shadow
                    overflow-hidden">

                    <div class="overflow-x-auto">

                        <table class="w-full text-sm text-left">

                            <thead class="bg-slate-50
                                border-b
                                border-slate-200">

                                <tr>

                                    <th class="px-5 py-4
                                        font-semibold
                                        text-slate-700">
                                        ID
                                    </th>

                                    <th class="px-5 py-4
                                        font-semibold
                                        text-slate-700">
                                        Nombre
                                    </th>

                                    <th class="px-5 py-4
                                        font-semibold
                                        text-slate-700">
                                        Empresa
                                    </th>

                                    <th class="px-5 py-4
                                        font-semibold
                                        text-slate-700">
                                        Teléfono
                                    </th>

                                    <th class="px-5 py-4
                                        font-semibold
                                        text-slate-700">
                                        Correo
                                    </th>

                                    <th class="px-5 py-4
                                        font-semibold
                                        text-slate-700">
                                        Sitio Web
                                    </th>

                                    <th class="px-5 py-4
                                        font-semibold
                                        text-slate-700
                                        text-center">
                                        Acciones
                                    </th>

                                </tr>

                            </thead>


                            <tbody class="divide-y divide-slate-100">

                                @if (Model != null && Model.Any())
                                {

                                    foreach (var proveedor in Model)
                                    {

                                        <tr class="hover:bg-slate-50 transition">


                                            <td class="px-5 py-4
                                                font-semibold
                                                text-slate-900">

                                                #@proveedor.IdProveedor

                                            </td>


                                            <td class="px-5 py-4
                                                text-slate-700">

                                                @proveedor.Nombre

                                            </td>


                                            <td class="px-5 py-4
                                                text-slate-700">

                                                @(proveedor.Empresa ?? "—")

                                            </td>


                                            <td class="px-5 py-4
                                                text-slate-600">

                                                @(proveedor.Telefono ?? "—")

                                            </td>


                                            <td class="px-5 py-4
                                                text-slate-600">

                                                @(proveedor.Correo ?? "—")

                                            </td>


                                            <td class="px-5 py-4">

                                                @if (!string.IsNullOrWhiteSpace(proveedor.SitioWeb))
                                                {
                                                    <a href="@proveedor.SitioWeb"
                                                       target="_blank"
                                                       class="text-indigo-600
                                                        hover:text-indigo-800
                                                        hover:underline">

                                                        Visitar sitio

                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="text-slate-400">
                                                        —
                                                    </span>
                                                }

                                            </td>


                                            <td class="px-5 py-4">

                                                <div class="flex
                                                    justify-center
                                                    gap-2
                                                    flex-wrap">


                                                    <a href="/Proveedor/Details/@proveedor.IdProveedor"
                                                       class="px-3 py-1.5
                                                        rounded-lg
                                                        bg-slate-100
                                                        text-slate-700
                                                        hover:bg-slate-200
                                                        transition">

                                                        Ver

                                                    </a>



                                                    <a href="/Proveedor/Edit/@proveedor.IdProveedor"
                                                       class="px-3 py-1.5
                                                        rounded-lg
                                                        bg-indigo-50
                                                        text-indigo-600
                                                        hover:bg-indigo-100
                                                        transition">

                                                        Editar

                                                    </a>


                                                    <a href="/Proveedor/Delete/@proveedor.IdProveedor"
                                                       class="px-3 py-1.5
                                                        rounded-lg
                                                        bg-red-50
                                                        text-red-600
                                                        hover:bg-red-100
                                                        transition">

                                                        Eliminar

                                                    </a>

                                                </div>

                                            </td>

                                        </tr>

                                    }

                                }
                                else
                                {

                                    <tr>

                                        <td colspan="7"
                                            class="px-5 py-10
                                            text-center">

                                            <p class="text-lg
                                                font-semibold
                                                text-slate-500">

                                                No hay proveedores registrados

                                            </p>

                                            <p class="text-sm
                                                text-slate-400
                                                mt-1">

                                                Agrega un proveedor
                                                para comenzar.

                                            </p>

                                        </td>

                                    </tr>

                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </main>

    </div>

</body>

</html>

