@model TechStore.Models.Proveedor

@{
    ViewData["Title"] = "Nuevo Proveedor";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - TechStore</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-100 min-h-screen">

    <div class="min-h-screen bg-slate-100 flex flex-col md:flex-row">

        <!-- SIDEBAR -->

        <aside class="w-full md:w-64 bg-slate-900 text-white p-5 shrink-0">

            <div class="flex items-center gap-3 mb-8">

                <div class="w-8 h-8 bg-indigo-500 rounded-lg flex items-center justify-center font-bold">
                    TS
                </div>

                <span class="font-bold text-lg">
                    TechStore Admin
                </span>

            </div>

            <nav class="space-y-1">

                <a href="/Admin/Dashboard"
                   class="block px-4 py-2.5 rounded-lg text-slate-400 hover:bg-indigo-600 hover:text-white transition">
                    Dashboard
                </a>

                <a href="/Usuario/Index"
                   class="block px-4 py-2.5 rounded-lg text-slate-400 hover:bg-indigo-600 hover:text-white transition">
                    Usuarios
                </a>

                <a href="/Producto/Index"
                   class="block px-4 py-2.5 rounded-lg text-slate-400 hover:bg-indigo-600 hover:text-white transition">
                    Productos
                </a>

                <a href="/Venta/Index"
                   class="block px-4 py-2.5 rounded-lg text-slate-400 hover:bg-indigo-600 hover:text-white transition">
                    Ventas
                </a>

                <a href="/Garantia/Index"
                   class="block px-4 py-2.5 rounded-lg text-slate-400 hover:bg-indigo-600 hover:text-white transition">
                    Garantías
                </a>

                <a href="/Proveedor/Index"
                   class="block px-4 py-2.5 rounded-lg bg-indigo-600 text-white">
                    Proveedores
                </a>

            </nav>

        </aside>


        <!-- CONTENIDO -->

        <main class="flex-1 p-6">

            <div class="max-w-2xl mx-auto">

                <div class="bg-white rounded-xl shadow p-6">

                    <!-- ENCABEZADO -->

                    <h1 class="text-2xl font-bold text-slate-900">
                        Nuevo Proveedor
                    </h1>

                    <p class="text-slate-500 mt-1 mb-6">
                        Registra un nuevo proveedor para TechStore.
                    </p>


                    <!-- MENSAJE DE ERROR -->
                    @if (TempData["Error"] != null)
                    {
                        <div class="mb-5 bg-red-50 border border-red-200
                            text-red-700 px-4 py-3 rounded-lg">

                            @TempData["Error"]

                        </div>
                    }


                    <!-- FORMULARIO -->

                    <form action="/Proveedor/Create"
                          method="post">

                        @Html.AntiForgeryToken()


                        <!-- NOMBRE -->

                        <div class="mb-5">

                            <label for="Nombre"
                                   class="block font-semibold text-slate-700 mb-2">

                                Nombre

                            </label>

                            <input type="text"
                                   id="Nombre"
                                   name="Nombre"
                                   value="@Model?.Nombre"
                                   required
                                   class="w-full border border-slate-300 rounded-lg
                            px-3 py-2.5 focus:outline-none
                            focus:ring-2 focus:ring-indigo-500" />

                        </div>


                        <!-- EMPRESA -->

                        <div class="mb-5">

                            <label for="Empresa"
                                   class="block font-semibold text-slate-700 mb-2">

                                Empresa

                            </label>

                            <input type="text"
                                   id="Empresa"
                                   name="Empresa"
                                   value="@Model?.Empresa"
                                   class="w-full border border-slate-300 rounded-lg
                            px-3 py-2.5 focus:outline-none
                            focus:ring-2 focus:ring-indigo-500" />

                        </div>


                        <!-- TELEFONO -->

                        <div class="mb-5">

                            <label for="Telefono"
                                   class="block font-semibold text-slate-700 mb-2">

                                Teléfono

                            </label>

                            <input type="text"
                                   id="Telefono"
                                   name="Telefono"
                                   value="@Model?.Telefono"
                                   class="w-full border border-slate-300 rounded-lg
                            px-3 py-2.5 focus:outline-none
                            focus:ring-2 focus:ring-indigo-500" />

                        </div>


                        <!-- CORREO -->

                        <div class="mb-5">

                            <label for="Correo"
                                   class="block font-semibold text-slate-700 mb-2">

                                Correo

                            </label>

                            <input type="email"
                                   id="Correo"
                                   name="Correo"
                                   value="@Model?.Correo"
                                   class="w-full border border-slate-300 rounded-lg
                            px-3 py-2.5 focus:outline-none
                            focus:ring-2 focus:ring-indigo-500" />

                        </div>


                        <!-- SITIO WEB -->

                        <div class="mb-6">

                            <label for="SitioWeb"
                                   class="block font-semibold text-slate-700 mb-2">

                                Sitio Web

                            </label>

                            <input type="text"
                                   id="SitioWeb"
                                   name="SitioWeb"
                                   value="@Model?.SitioWeb"
                                   placeholder="https://ejemplo.com"
                                   class="w-full border border-slate-300 rounded-lg
                            px-3 py-2.5 focus:outline-none
                            focus:ring-2 focus:ring-indigo-500" />

                        </div>


                        <!-- BOTONES -->

                        <div class="flex justify-end gap-3
                            pt-4 border-t border-slate-200">

                            <a href="/Proveedor/Index"
                               class="px-5 py-2.5 rounded-lg border
                                border-slate-300 text-slate-600
                                hover:bg-slate-100 transition">

                                Cancelar

                            </a>

                            <button type="submit"
                                    class="bg-indigo-600 text-white
                                px-5 py-2.5 rounded-lg shadow
                                hover:bg-indigo-700 transition">

                                Guardar Proveedor

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </main>

    </div>

</body>
</html>
