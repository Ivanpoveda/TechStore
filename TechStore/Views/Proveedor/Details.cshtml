@model TechStore.Models.Proveedor

@{
    ViewData["Title"] = "Detalles del Proveedor";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - TechStore</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-100 min-h-screen">

    <div class="min-h-screen bg-slate-100 flex flex-col md:flex-row">

        ```
        <aside class="w-full md:w-64 bg-slate-900 text-white p-5 shrink-0">

            <div class="flex items-center gap-3 mb-8">

                <div class="w-8 h-8 bg-indigo-500 rounded-lg flex items-center justify-center font-bold">
                    TS
                </div>

                <span class="font-bold text-lg">
                    TechStore Admin
                </span>

            </div>

            <nav class="space-y-1">

                <a href="/Admin/Dashboard"
                   class="block px-4 py-2.5 rounded-lg text-slate-400 hover:bg-indigo-600 hover:text-white transition">
                    Dashboard
                </a>

                <a href="/Usuario/Index"
                   class="block px-4 py-2.5 rounded-lg text-slate-400 hover:bg-indigo-600 hover:text-white transition">
                    Usuarios
                </a>

                <a href="/Producto/Index"
                   class="block px-4 py-2.5 rounded-lg text-slate-400 hover:bg-indigo-600 hover:text-white transition">
                    Productos
                </a>

                <a href="/Venta/Index"
                   class="block px-4 py-2.5 rounded-lg text-slate-400 hover:bg-indigo-600 hover:text-white transition">
                    Ventas
                </a>

                <a href="/Garantia/Index"
                   class="block px-4 py-2.5 rounded-lg text-slate-400 hover:bg-indigo-600 hover:text-white transition">
                    Garantías
                </a>

                <a href="/Proveedor/Index"
                   class="block px-4 py-2.5 rounded-lg bg-indigo-600 text-white">
                    Proveedores
                </a>

            </nav>

        </aside>


        <main class="flex-1 p-6">

            <div class="max-w-2xl mx-auto">

                <div class="bg-white rounded-xl shadow p-6">

                    <div class="flex justify-between items-start mb-6">

                        <div>

                            <h1 class="text-2xl font-bold text-slate-900">
                                Detalles del Proveedor
                            </h1>

                            <p class="text-slate-500 mt-1">
                                Información registrada del proveedor.
                            </p>

                        </div>

                        <span class="bg-indigo-50 text-indigo-600
                            px-3 py-1 rounded-full text-sm font-semibold">
                            #@Model.IdProveedor
                        </span>

                    </div>


                    <div class="space-y-4">

                        <div class="border-b border-slate-100 pb-4">

                            <p class="text-sm text-slate-500">
                                Nombre
                            </p>

                            <p class="font-semibold text-slate-900">
                                @Model.Nombre
                            </p>

                        </div>


                        <div class="border-b border-slate-100 pb-4">

                            <p class="text-sm text-slate-500">
                                Empresa
                            </p>

                            <p class="font-semibold text-slate-900">
                                @(Model.Empresa ?? "No especificada")
                            </p>

                        </div>


                        <div class="border-b border-slate-100 pb-4">

                            <p class="text-sm text-slate-500">
                                Teléfono
                            </p>

                            <p class="font-semibold text-slate-900">
                                @(Model.Telefono ?? "No especificado")
                            </p>

                        </div>


                        <div class="border-b border-slate-100 pb-4">

                            <p class="text-sm text-slate-500">
                                Correo
                            </p>

                            <p class="font-semibold text-slate-900">
                                @(Model.Correo ?? "No especificado")
                            </p>

                        </div>


                        <div>

                            <p class="text-sm text-slate-500">
                                Sitio Web
                            </p>

                            @if (!string.IsNullOrWhiteSpace(Model.SitioWeb))
                            {
                                <a href="@Model.SitioWeb"
                                   target="_blank"
                                   class="font-semibold text-indigo-600 hover:underline">

                                    @Model.SitioWeb

                                </a>
                            }
                            else
                            {
                                <p class="font-semibold text-slate-900">
                                    No especificado
                                </p>
                            }

                        </div>

                    </div>


                    <div class="flex justify-end gap-3 mt-8 pt-4 border-t border-slate-200">

                        <a href="/Proveedor/Index"
                           class="px-5 py-2.5 rounded-lg border border-slate-300
                            text-slate-600 hover:bg-slate-100 transition">

                            Volver

                        </a>

                        <a href="/Proveedor/Edit/@Model.IdProveedor"
                           class="bg-indigo-600 text-white px-5 py-2.5 rounded-lg
                            hover:bg-indigo-700 transition">

                            Editar

                        </a>

                    </div>

                </div>

            </div>

        </main>
        ```

    </div>

</body>
</html>