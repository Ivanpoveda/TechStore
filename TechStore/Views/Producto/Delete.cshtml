@model TechStore.Models.Producto

@{
    ViewData["Title"] = "Eliminar Producto";
}

<!DOCTYPE html>

<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TechStore</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-slate-100 min-h-screen">

    <div class="flex flex-col md:flex-row min-h-screen">

        <!-- SIDEBAR -->
        <aside class="w-full md:w-64 bg-slate-900 text-white p-5 shrink-0">

            <div class="flex items-center gap-3 mb-8">

                <div class="w-8 h-8 bg-indigo-500 rounded-lg flex items-center justify-center font-bold">
                    TS
                </div>

                <span class="font-bold text-lg tracking-wide">
                    TechStore Admin
                </span>

            </div>

            <nav class="space-y-1">

                <a href="/Admin/Dashboard"
                   class="block px-4 py-2.5 rounded-lg text-slate-400 hover:bg-indigo-600 hover:text-white transition">
                    Dashboard
                </a>

                <a href="/Usuario/Index"
                   class="block px-4 py-2.5 rounded-lg text-slate-400 hover:bg-indigo-600 hover:text-white transition">
                    Usuarios
                </a>

                <a href="/Producto/Index"
                   class="block px-4 py-2.5 rounded-lg bg-indigo-600 text-white font-medium">
                    Productos
                </a>

                <a href="/Venta/Index"
                   class="block px-4 py-2.5 rounded-lg text-slate-400 hover:bg-indigo-600 hover:text-white transition">
                    Ventas
                </a>

                <a href="/Garantia/Index"
                   class="block px-4 py-2.5 rounded-lg text-slate-400 hover:bg-indigo-600 hover:text-white transition">
                    Garantías
                </a>

                <a href="/Proveedor/Index"
                   class="block px-4 py-2.5 rounded-lg text-slate-400 hover:bg-indigo-600 hover:text-white transition">
                    Proveedores
                </a>

            </nav>

        </aside>


        <!-- CONTENIDO -->
        <main class="flex-1 p-6 md:p-8">

            <div class="max-w-lg mx-auto">

                <div class="bg-white rounded-xl shadow p-6">

                    <div class="text-center mb-6">

                        <div class="w-16 h-16 mx-auto mb-4 bg-red-100
                            text-red-600 rounded-full
                            flex items-center justify-center text-2xl">
                            !
                        </div>

                        <h1 class="text-2xl font-bold text-slate-900">
                            Eliminar Producto
                        </h1>

                        <p class="text-slate-500 mt-2">
                            ¿Estás seguro de que deseas eliminar este producto?
                        </p>

                    </div>


                    <!-- INFORMACION -->
                    <div class="bg-slate-50 rounded-lg p-4 space-y-3 mb-6">

                        <div>
                            <span class="font-semibold text-slate-600">
                                Producto:
                            </span>

                            <span class="text-slate-900">
                                @Model.Nombre
                            </span>
                        </div>


                        <div>
                            <span class="font-semibold text-slate-600">
                                Precio:
                            </span>

                            <span class="text-slate-900">
                                ₡@Model.Precio.ToString("N2")
                            </span>
                        </div>


                        <div>
                            <span class="font-semibold text-slate-600">
                                Stock:
                            </span>

                            <span class="text-slate-900">
                                @Model.Stock unidades
                            </span>
                        </div>


                        <div>
                            <span class="font-semibold text-slate-600">
                                Categoría:
                            </span>

                            <span class="text-slate-900">
                                @Model.IdCategoriaNavigation?.Nombre
                            </span>
                        </div>


                        <div>
                            <span class="font-semibold text-slate-600">
                                Marca:
                            </span>

                            <span class="text-slate-900">
                                @Model.IdMarcaNavigation?.Nombre
                            </span>
                        </div>

                    </div>


                    <!-- FORMULARIO -->
                    <form action="/Producto/Delete"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="IdProducto"
                               value="@Model.IdProducto" />


                        <div class="flex justify-end gap-3">

                            <a href="/Producto/Index"
                               class="px-4 py-2 rounded-lg border border-slate-300
                                text-slate-600 hover:bg-slate-100 transition">
                                Cancelar
                            </a>

                            <button type="submit"
                                    class="bg-red-600 text-white px-5 py-2
                                rounded-lg shadow hover:bg-red-700 transition">
                                Confirmar Eliminación
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </main>

    </div>

</body>

</html>
