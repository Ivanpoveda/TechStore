@model TechStore.Models.Producto

@{
    ViewData["Title"] = "Crear Producto";
}

<!DOCTYPE html>

<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TechStore</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-slate-100 min-h-screen">

    <div class="flex flex-col md:flex-row min-h-screen">

        <!-- SIDEBAR -->
        <aside class="w-full md:w-64 bg-slate-900 text-white p-5 flex flex-col justify-between shrink-0">

            <div>

                <div class="flex items-center gap-3 mb-8">
                    <div class="w-8 h-8 bg-indigo-500 rounded-lg flex items-center justify-center font-bold">
                        TS
                    </div>

                    <span class="font-bold text-lg tracking-wide">
                        TechStore Admin
                    </span>
                </div>

                <nav class="space-y-1">

                    <a href="/Admin/Dashboard"
                       class="block px-4 py-2.5 rounded-lg text-slate-400 hover:bg-indigo-600 hover:text-white transition">
                        Dashboard
                    </a>

                    <a href="/Usuario/Index"
                       class="block px-4 py-2.5 rounded-lg text-slate-400 hover:bg-indigo-600 hover:text-white transition">
                        Usuarios
                    </a>

                    <a href="/Producto/Index"
                       class="block px-4 py-2.5 rounded-lg bg-indigo-600 text-white font-medium">
                        Productos
                    </a>

                    <a href="/Venta/Index"
                       class="block px-4 py-2.5 rounded-lg text-slate-400 hover:bg-indigo-600 hover:text-white transition">
                        Ventas
                    </a>

                    <a href="/Garantia/Index"
                       class="block px-4 py-2.5 rounded-lg text-slate-400 hover:bg-indigo-600 hover:text-white transition">
                        Garantías
                    </a>

                    <a href="/Proveedor/Index"
                       class="block px-4 py-2.5 rounded-lg text-slate-400 hover:bg-indigo-600 hover:text-white transition">
                        Proveedores
                    </a>

                </nav>

            </div>

        </aside>


        <!-- CONTENIDO -->
        <main class="flex-1 p-6 md:p-8">

            <div class="max-w-2xl mx-auto">

                <div class="bg-white rounded-xl shadow p-6">

                    <h1 class="text-2xl font-bold text-slate-900 mb-2">
                        Crear Producto
                    </h1>

                    <p class="text-slate-500 mb-6">
                        Registra un nuevo producto en el catálogo.
                    </p>


                    <form action="/Producto/Create" method="post" class="space-y-5">

                        @Html.AntiForgeryToken()


                        <!-- NOMBRE -->
                        <div>

                            <label class="block font-semibold text-slate-600 mb-1">
                                Nombre
                            </label>

                            <input type="text"
                                   name="Nombre"
                                   value="@Model?.Nombre"
                                   required
                                   maxlength="80"
                                   class="w-full border border-slate-300 rounded-lg
                            px-3 py-2 focus:outline-none focus:ring-2
                            focus:ring-indigo-500" />

                        </div>


                        <!-- DESCRIPCION -->
                        <div>

                            <label class="block font-semibold text-slate-600 mb-1">
                                Descripción
                            </label>

                            <textarea name="Descripcion"
                                      rows="4"
                                      maxlength="300"
                                      class="w-full border border-slate-300 rounded-lg
                            px-3 py-2 focus:outline-none focus:ring-2
                            focus:ring-indigo-500">@Model?.Descripcion</textarea>

                        </div>


                        <!-- PRECIO -->
                        <div>

                            <label class="block font-semibold text-slate-600 mb-1">
                                Precio
                            </label>

                            <input type="number"
                                   name="Precio"
                                   value="@Model?.Precio"
                                   min="0"
                                   step="0.01"
                                   required
                                   class="w-full border border-slate-300 rounded-lg
                            px-3 py-2 focus:outline-none focus:ring-2
                            focus:ring-indigo-500" />

                        </div>


                        <!-- STOCK -->
                        <div>

                            <label class="block font-semibold text-slate-600 mb-1">
                                Stock
                            </label>

                            <input type="number"
                                   name="Stock"
                                   value="@Model?.Stock"
                                   min="0"
                                   required
                                   class="w-full border border-slate-300 rounded-lg
                            px-3 py-2 focus:outline-none focus:ring-2
                            focus:ring-indigo-500" />

                        </div>


                        <!-- STOCK MINIMO -->
                        <div>

                            <label class="block font-semibold text-slate-600 mb-1">
                                Stock mínimo
                            </label>

                            <input type="number"
                                   name="StockMin"
                                   value="@Model?.StockMin"
                                   min="0"
                                   required
                                   class="w-full border border-slate-300 rounded-lg
                            px-3 py-2 focus:outline-none focus:ring-2
                            focus:ring-indigo-500" />

                        </div>


                        <!-- CATEGORIA -->
                        <div>

                            <label class="block font-semibold text-slate-600 mb-1">
                                Categoría
                            </label>

                            <select name="IdCategoria"
                                    required
                                    class="w-full border border-slate-300 rounded-lg
                                px-3 py-2 focus:outline-none focus:ring-2
                                focus:ring-indigo-500">

                                <option value="">
                                    Seleccione una categoría
                                </option>

                                @foreach (var item in (SelectList)ViewData["IdCategoria"])
                                {
                                    <option value="@item.Value">
                                        @item.Text
                                    </option>
                                }

                            </select>

                        </div>


                        <!-- MARCA -->
                        <div>

                            <label class="block font-semibold text-slate-600 mb-1">
                                Marca
                            </label>

                            <select name="IdMarca"
                                    required
                                    class="w-full border border-slate-300 rounded-lg
                                px-3 py-2 focus:outline-none focus:ring-2
                                focus:ring-indigo-500">

                                <option value="">
                                    Seleccione una marca
                                </option>

                                @foreach (var item in (SelectList)ViewData["IdMarca"])
                                {
                                    <option value="@item.Value">
                                        @item.Text
                                    </option>
                                }

                            </select>

                        </div>


                        <!-- BOTONES -->
                        <div class="flex justify-end gap-3 pt-4">

                            <a href="/Producto/Index"
                               class="px-4 py-2 rounded-lg border border-slate-300
                                text-slate-600 hover:bg-slate-100 transition">
                                Cancelar
                            </a>

                            <button type="submit"
                                    class="bg-indigo-600 text-white px-5 py-2
                                rounded-lg shadow hover:bg-indigo-700 transition">
                                Guardar Producto
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </main>

    </div>

</body>

</html>
