@model TechStore.Models.Usuario
@{
    ViewData["Title"] = "Detalles del Usuario";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TechStore</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 min-h-screen p-6">

    <div class="max-w-lg mx-auto bg-white rounded-xl shadow p-6">
        <h1 class="text-2xl font-bold text-slate-900 mb-6">Detalles del Usuario</h1>

        <dl class="space-y-4">
            <div>
                <dt class="font-semibold text-slate-600">Nombre</dt>
                <dd class="text-slate-900">@Model.Nombre</dd>
            </div>
            <div>
                <dt class="font-semibold text-slate-600">Apellidos</dt>
                <dd class="text-slate-900">@Model.Apellidos</dd>
            </div>
            <div>
                <dt class="font-semibold text-slate-600">Correo</dt>
                <dd class="text-slate-900">@Model.Correo</dd>
            </div>
            <div>
                <dt class="font-semibold text-slate-600">Teléfono</dt>
                <dd class="text-slate-900">@Model.Telefono</dd>
            </div>
            <div>
                <dt class="font-semibold text-slate-600">Rol</dt>
                <dd class="text-slate-900">@Model.IdRolNavigation?.Nombre</dd>
            </div>
            <div>
                <dt class="font-semibold text-slate-600">Estado</dt>
                <dd class="text-slate-900">@Model.Estado</dd>
            </div>
            <div>
                <dt class="font-semibold text-slate-600">Fecha de Registro</dt>
                <dd class="text-slate-900">@Model.FechaRegistro.ToString("dd/MM/yyyy")</dd>
            </div>
        </dl>

        <div class="flex justify-end space-x-3 mt-6">
            <a href="/Usuario/Edit/@Model.IdUsuario" class="bg-indigo-600 text-white px-4 py-2 rounded-lg shadow hover:bg-indigo-700 transition">
                Editar
            </a>
            <a href="/Usuario/Index" class="px-4 py-2 rounded-lg border border-slate-300 text-slate-600 hover:bg-slate-100 transition">
                Volver
            </a>
        </div>
    </div>

</body>
</html>
