@model TechStore.Models.Usuario

@{
    ViewData["Title"] = "Editar Usuario";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TechStore</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 min-h-screen p-6">

    <div class="max-w-lg mx-auto bg-white rounded-xl shadow p-6">

        <h1 class="text-2xl font-bold text-slate-900 mb-6">
            Editar Usuario
        </h1>

        <form action="/Usuario/Edit" method="post" class="space-y-4">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="IdUsuario"
                   value="@Model.IdUsuario" />

            <input type="hidden"
                   name="Correo"
                   value="@Model.Correo" />

            <input type="hidden"
                   name="Contrasenia"
                   value="@Model.Contrasenia" />

            <input type="hidden"
                   name="IdRol"
                   value="@Model.IdRol" />

            <input type="hidden"
                   name="Estado"
                   value="@Model.Estado" />

            <input type="hidden"
                   name="FechaRegistro"
                   value="@Model.FechaRegistro.ToString("yyyy-MM-ddTHH:mm:ss")" />

            <div>
                <label class="font-semibold text-slate-600">
                    Nombre
                </label>

                <input type="text"
                       name="Nombre"
                       value="@Model.Nombre"
                       required
                       class="w-full border border-slate-300 rounded-lg px-3 py-2 mt-1" />
            </div>

            <div>
                <label class="font-semibold text-slate-600">
                    Apellidos
                </label>

                <input type="text"
                       name="Apellidos"
                       value="@Model.Apellidos"
                       required
                       class="w-full border border-slate-300 rounded-lg px-3 py-2 mt-1" />
            </div>

            <div>
                <label class="font-semibold text-slate-600">
                    Teléfono
                </label>

                <input type="text"
                       name="Telefono"
                       value="@Model.Telefono"
                       class="w-full border border-slate-300 rounded-lg px-3 py-2 mt-1" />
            </div>

            <div>
                <label class="font-semibold text-slate-600">
                    Correo
                </label>

                <input type="text"
                       value="@Model.Correo"
                       disabled
                       class="w-full border border-slate-300 rounded-lg px-3 py-2 mt-1 bg-slate-100 text-slate-500" />
            </div>

            <div class="flex justify-end space-x-3 mt-6">

                <a href="/Usuario/Index"
                   class="px-4 py-2 rounded-lg border border-slate-300 text-slate-600 hover:bg-slate-100 transition">
                    Cancelar
                </a>

                <button type="submit"
                        class="bg-indigo-600 text-white px-4 py-2 rounded-lg shadow hover:bg-indigo-700 transition">
                    Actualizar
                </button>

            </div>

        </form>

    </div>

</body>
</html>