@model TechStore.Models.DetalleCompra

@{
    ViewData["Title"] = "Eliminar producto";
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Eliminar producto - TechStore</title>

    <script src="https://cdn.tailwindcss.com"></script>

</head>

<body class="bg-slate-100 min-h-screen">

    <div class="min-h-screen flex items-center justify-center p-6">

        <div class="w-full max-w-lg">

            <div class="bg-white rounded-xl
                shadow-sm
                border border-red-200
                p-8">


                <div class="w-16 h-16
                    bg-red-100
                    rounded-full
                    flex items-center
                    justify-center
                    text-3xl
                    mx-auto mb-5">

                    ⚠️

                </div>


                <h1 class="text-2xl font-bold
                    text-slate-900
                    text-center">

                    Eliminar producto

                </h1>


                <p class="text-slate-500
                    text-center
                    mt-2 mb-6">

                    ¿Estás seguro de que deseas eliminar
                    este producto de la compra?

                </p>


                <!-- INFORMACIÓN -->

                <div class="bg-slate-50
                    rounded-lg
                    p-5 mb-6">

                    <div class="flex justify-between
                        mb-3">

                        <span class="text-slate-500">
                            Producto
                        </span>

                        <span class="font-semibold
                            text-slate-900">

                            @Model.IdProductoNavigation?.Nombre

                        </span>

                    </div>


                    <div class="flex justify-between
                        mb-3">

                        <span class="text-slate-500">
                            Cantidad
                        </span>

                        <span class="font-semibold">
                            @Model.Cantidad
                        </span>

                    </div>


                    <div class="flex justify-between
                        mb-3">

                        <span class="text-slate-500">
                            Precio
                        </span>

                        <span class="font-semibold">
                            ₡@Model.PrecioCompra.ToString("N2")
                        </span>

                    </div>


                    <div class="border-t
                        border-slate-200
                        pt-3
                        flex justify-between">

                        <span class="font-semibold">
                            Subtotal
                        </span>

                        <span class="font-bold
                            text-lg
                            text-red-600">

                            ₡@Model.Subtotal.ToString("N2")

                        </span>

                    </div>

                </div>


                <!-- FORM -->

                <form asp-action="Delete"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           value="@Model.IdDetalleCompra" />


                    <div class="flex gap-3">

                        <a href="/CompraProveedor/Details/@Model.IdCompra"
                           class="flex-1
                            px-5 py-3
                            text-center
                            rounded-lg
                            border border-slate-300
                            text-slate-700
                            hover:bg-slate-100">

                            Cancelar

                        </a>


                        <button type="submit"
                                class="flex-1
                            px-5 py-3
                            rounded-lg
                            bg-red-600
                            text-white
                            font-medium
                            hover:bg-red-700">

                            Sí, eliminar

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</body>

</html>