@model TechStore.ViewModels.DashboardViewModel

<link rel="stylesheet" href="~/css/dashboard.css" />

<div class="admin-layout">
    <!-- Barra lateral -->
    <aside class="sidebar">
        <h2>Admin Panel</h2>
        <ul>
            <li><a asp-controller="Usuario" asp-action="Index">Usuarios</a></li>
            <li><a asp-controller="Producto" asp-action="Index">Productos</a></li>
            <li><a asp-controller="Venta" asp-action="Index">Ventas</a></li>
            <li><a asp-controller="Admin" asp-action="Dashboard">Reportes</a></li>
            <li><a asp-controller="Garantia" asp-action="Index">Garantías</a></li>
            <li><a asp-controller="Proveedor" asp-action="Index">Proveedores</a></li>
        </ul>
    </aside>

    <!-- Contenido principal -->
    <main class="dashboard-wrapper">
        <h2>Resumen de Ventas</h2>
        <p>Bienvenido al panel general de estadísticas.</p>

        <div class="stats-cards">
            <div class="card ingresos">
                <h3>INGRESOS TOTALES</h3>
                <p>@Model.IngresosTotales.ToString("C")</p>
            </div>
            <div class="card clientes">
                <h3>NUEVOS CLIENTES</h3>
                <p>@Model.NuevosClientes</p>
            </div>
            <div class="card ordenes">
                <h3>ÓRDENES PENDIENTES</h3>
                <p>@Model.OrdenesPendientes</p>
            </div>
        </div>

        <h3>Últimos Pedidos</h3>
        <table class="table">
            <thead>
                <tr>
                    <th>Cliente</th>
                    <th>Estado</th>
                    <th>Monto</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pedido in Model.UltimosPedidos)
                {
                    <tr>
                        <td>@pedido.Cliente</td>
                        <td>@pedido.Estado</td>
                        <td>@pedido.Monto.ToString("C")</td>
                    </tr>
                }
            </tbody>
        </table>
    </main>
</div>

