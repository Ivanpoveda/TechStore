@model TechStore.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard Admin";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TechStore</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col md:flex-row">

    <!-- Sidebar -->
    <aside class="w-full md:w-64 bg-slate-900 text-white p-5 flex flex-col justify-between shrink-0">
        <div>
            <div class="flex items-center gap-3 mb-8">
                <div class="w-8 h-8 bg-indigo-500 rounded-lg flex items-center justify-center font-bold">TS</div>
                <span class="font-bold text-lg tracking-wide">TechStore Admin</span>
            </div>
            <nav class="space-y-1">
                <a href="/Admin/Dashboard"
                   class="flex items-center gap-3 px-4 py-2.5 rounded-lg transition
                    bg-indigo-600 text-white font-medium
                    hover:bg-indigo-700 hover:scale-105">
                    Dashboard
                </a>
                <a href="/Usuario/Index"
                   class="flex items-center gap-3 px-4 py-2.5 rounded-lg transition
                    text-slate-400 hover:bg-indigo-600 hover:text-white hover:scale-105">
                    Usuarios
                </a>
                <a href="/Producto/Index"
                   class="flex items-center gap-3 px-4 py-2.5 rounded-lg transition
                    text-slate-400 hover:bg-indigo-600 hover:text-white hover:scale-105">
                    Productos
                </a>
                <a href="/Venta/Index"
                   class="flex items-center gap-3 px-4 py-2.5 rounded-lg transition
                    text-slate-400 hover:bg-indigo-600 hover:text-white hover:scale-105">
                    Ventas
                </a>
                <a href="/Garantia/Index"
                   class="flex items-center gap-3 px-4 py-2.5 rounded-lg transition
                    text-slate-400 hover:bg-indigo-600 hover:text-white hover:scale-105">
                    Garantías
                </a>
                <a href="/Proveedor/Index"
                   class="flex items-center gap-3 px-4 py-2.5 rounded-lg transition
                    text-slate-400 hover:bg-indigo-600 hover:text-white hover:scale-105">
                    Proveedores
                </a>
            </nav>
        </div>
        <div class="pt-4 border-t border-slate-800 flex items-center justify-between mt-6">
            <div class="text-xs">
                <p class="font-semibold text-white">Administrador</p>
                <p class="text-slate-400">admin@techstore.com</p>
            </div>
            <a href="/Account/Login" class="text-xs text-rose-400 hover:underline hover:text-rose-300 transition">Salir</a>
        </div>
    </aside>

    <!-- Contenido principal -->
    <main class="flex-1 p-6 md:p-10">
        <header class="flex justify-between items-center mb-8">
            <div>
                <h1 class="text-2xl font-bold text-slate-900">Panel de Administración</h1>
                <p class="text-slate-500 text-sm">Bienvenido al panel general de estadísticas.</p>
            </div>
            <span class="px-3 py-1 bg-emerald-100 text-emerald-700 font-semibold text-xs rounded-full">Sistema Activo</span>
        </header>

        <!-- Tarjetas -->
        <section class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
            <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
                <p class="text-xs font-bold text-slate-400 uppercase">Ingresos Totales</p>
                <p class="text-3xl font-extrabold text-slate-900 mt-2">@string.Format("{0:C}", Model.IngresosTotales)</p>
            </div>
            <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
                <p class="text-xs font-bold text-slate-400 uppercase">Usuarios Activos</p>
                <p class="text-3xl font-extrabold text-slate-900 mt-2">@Model.UsuariosActivos</p>
            </div>
            <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
                <p class="text-xs font-bold text-slate-400 uppercase">Productos en Stock</p>
                <p class="text-3xl font-extrabold text-slate-900 mt-2">@Model.ProductosEnStock</p>
            </div>
            <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
                <p class="text-xs font-bold text-slate-400 uppercase">Órdenes Pendientes</p>
                <p class="text-3xl font-extrabold text-slate-900 mt-2">@Model.OrdenesPendientes</p>
            </div>
        </section>

        <!-- Gráficos -->
        <section class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
            <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
                <h2 class="font-bold text-slate-800 mb-4">Ventas por Mes</h2>
                <canvas id="ventasChart"></canvas>
            </div>
            <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
                <h2 class="font-bold text-slate-800 mb-4">Ventas por Estado</h2>
                <canvas id="estadoChart"></canvas>
            </div>
        </section>

        <!-- Reportes -->
        <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
                <h2 class="font-bold text-slate-800 mb-4">Productos con Stock Bajo</h2>
                <table class="w-full text-left text-sm">
                    <thead class="bg-slate-50 text-slate-500 font-semibold uppercase text-xs">
                        <tr>
                            <th class="px-4 py-2">Producto</th>
                            <th class="px-4 py-2">Marca</th>
                            <th class="px-4 py-2">Stock</th>
                            <th class="px-4 py-2">Mínimo</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var p in Model.ProductosStockBajo)
                        {
                            <tr>
                                <td class="px-4 py-2">@p.Nombre</td>
                                <td class="px-4 py-2">@p.Marca</td>
                                <td class="px-4 py-2">@p.Stock</td>
                                <td class="px-4 py-2">@p.StockMin</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
                <h2 class="font-bold text-slate-800 mb-4">Detalle de Ventas</h2>
                <table class="w-full text-left text-sm">
                    <thead class="bg-slate-50 text-slate-500 font-semibold uppercase text-xs">
                        <tr>
                            <th class="px-4 py-2">Cliente</th>
                            <th class="px-4 py-2">Producto</th>
                            <th class="px-4 py-2">Cantidad</th>
                            <th class="px-4 py-2">Total</th>
                            <th class="px-4 py-2">Estado</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var v in Model.DetalleVentas)
                        {
                            <tr>
                                <td class="px-4 py-2">@v.Cliente</td>
                                <td class="px-4 py-2">@v.Producto</td>
                                <td class="px-4 py-2">@v.Cantidad</td>
                                <td class="px-4 py-2">@string.Format("{0:C}", v.Total)</td>
                                <td class="px-4 py-2">@v.Estado</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </main>
</body>

<!-- Scripts de Chart.js -->
<script>
    // Gráfico de barras (ventas por mes)
    var ctx1 = document.getElementById('ventasChart').getContext('2d');
    var ventasChart = new Chart(ctx1, {
        type: 'bar',
        data: {
            labels: @Html.Raw(Json.Serialize(Model.Meses)),
            datasets: [{
                label: 'Ventas por mes',
                data: @Html.Raw(Json.Serialize(Model.VentasPorMes)),
                backgroundColor: '#3b82f6' // azul Tailwind
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { display: false },
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            return '$' + context.formattedValue;
                        }
                    }
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: { color: '#374151' }
                },
                x: {
                    ticks: { color: '#374151' }
                }
            }
        }
    });

    // Gráfico de pastel (ventas por estado)
    var ctx2 = document.getElementById('estadoChart').getContext('2d');
    var estadoChart = new Chart(ctx2, {
        type: 'pie',
        data: {
            labels: @Html.Raw(Json.Serialize(Model.Estados)),
            datasets: [{
                data: @Html.Raw(Json.Serialize(Model.VentasPorEstado)),
                backgroundColor: ['#10b981', '#f59e0b', '#ef4444'] // verde, amarillo, rojo Tailwind
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: { color: '#374151', font: { size: 12 } }
                },
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            return context.label + ': ' + context.formattedValue;
                        }
                    }
                }
            }
        }
    });
</script>
</html>