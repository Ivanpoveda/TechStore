@model TechStore.Models.Ventum

@{
    ViewData["Title"] = "Editar Venta";
}

<!DOCTYPE html>

<html lang="es">

<head>

    ```
    <meta charset="utf-8" />

    <title>
        @ViewData["Title"] - TechStore
    </title>

    <script src="https://cdn.tailwindcss.com"></script>
    ```

</head>

<body class="bg-slate-100 min-h-screen">

    <div class="min-h-screen flex flex-col md:flex-row">

        ```
        <!-- SIDEBAR -->

        <aside class="w-full md:w-64 bg-slate-900 text-white p-5 shrink-0">

            <div class="flex items-center gap-3 mb-8">

                <div class="w-8 h-8 bg-indigo-500 rounded-lg flex items-center justify-center font-bold">
                    TS
                </div>

                <span class="font-bold text-lg">
                    TechStore Admin
                </span>

            </div>

            <nav class="space-y-1">

                <a href="/Admin/Dashboard"
                   class="block px-4 py-2.5 rounded-lg text-slate-400 hover:bg-indigo-600 hover:text-white transition">
                    Dashboard
                </a>

                <a href="/Usuario/Index"
                   class="block px-4 py-2.5 rounded-lg text-slate-400 hover:bg-indigo-600 hover:text-white transition">
                    Usuarios
                </a>

                <a href="/Producto/Index"
                   class="block px-4 py-2.5 rounded-lg text-slate-400 hover:bg-indigo-600 hover:text-white transition">
                    Productos
                </a>

                <a href="/Venta/Index"
                   class="block px-4 py-2.5 rounded-lg bg-indigo-600 text-white">
                    Ventas
                </a>

                <a href="/Garantia/Index"
                   class="block px-4 py-2.5 rounded-lg text-slate-400 hover:bg-indigo-600 hover:text-white transition">
                    Garantías
                </a>

                <a href="/Proveedor/Index"
                   class="block px-4 py-2.5 rounded-lg text-slate-400 hover:bg-indigo-600 hover:text-white transition">
                    Proveedores
                </a>

            </nav>

        </aside>


        <!-- CONTENIDO -->

        <main class="flex-1 p-6">

            <div class="max-w-2xl mx-auto">

                <div class="bg-white rounded-xl shadow p-6">

                    <h1 class="text-2xl font-bold text-slate-900">
                        Editar Venta #@Model.IdVenta
                    </h1>

                    <p class="text-slate-500 mt-1 mb-6">
                        Actualiza el estado de la venta.
                    </p>


                    @if (TempData["Error"] != null)
                    {
                        <div class="mb-5 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg">
                            @TempData["Error"]
                        </div>
                    }


                    <div class="bg-slate-50 rounded-lg p-4 mb-6">

                        <p class="text-sm text-slate-500">
                            Cliente
                        </p>

                        <p class="font-semibold text-slate-900">
                            @Model.IdUsuarioNavigation?.Nombre
                            @Model.IdUsuarioNavigation?.Apellidos
                        </p>

                        <p class="text-sm text-slate-500">
                            Venta creada:
                            @Model.Fecha.ToString("dd-MM-yyyy HH:mm")
                        </p>

                    </div>


                    <form action="/Venta/Edit" method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="IdVenta"
                               value="@Model.IdVenta" />


                        <div class="mb-6">

                            <label class="block font-semibold text-slate-700 mb-2">
                                Estado
                            </label>

                            <select name="Estado"
                                    class="w-full border border-slate-300 rounded-lg px-3 py-2.5 focus:ring-2 focus:ring-indigo-500 focus:outline-none"
                                    required>

                                <option value="Pendiente"
                                        selected="@(Model.Estado == "Pendiente")">
                                    Pendiente
                                </option>

                                <option value="Completada"
                                        selected="@(Model.Estado == "Completada")">
                                    Completada
                                </option>

                                <option value="Cancelada"
                                        selected="@(Model.Estado == "Cancelada")">
                                    Cancelada
                                </option>

                            </select>

                        </div>


                        @if (Model.Estado == "Cancelada")
                        {
                            <div class="mb-6 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg">

                                Esta venta ya está cancelada.
                                No puede cambiar nuevamente de estado.

                            </div>
                        }


                        <div class="flex justify-end gap-3">

                            <a href="/Venta/Details/@Model.IdVenta"
                               class="px-5 py-2.5 rounded-lg border border-slate-300 text-slate-600 hover:bg-slate-100 transition">
                                Cancelar
                            </a>

                            @if (Model.Estado != "Cancelada")
                            {
                                <button type="submit"
                                        class="bg-indigo-600 text-white px-5 py-2.5 rounded-lg shadow hover:bg-indigo-700 transition">
                                    Guardar cambios
                                </button>
                            }

                        </div>

                    </form>

                </div>

            </div>

        </main>
        ```

    </div>

</body>

</html>

