@model TechStore.Models.Ventum

@{
    ViewData["Title"] = $"Venta #{Model.IdVenta}";
}

<!DOCTYPE html>

<html lang="es">

<head>

    ```
    <meta charset="utf-8" />

    <title>
        @ViewData["Title"] - TechStore
    </title>

    <script src="https://cdn.tailwindcss.com"></script>
    ```

</head>

<body class="bg-slate-100 min-h-screen">

    <div class="min-h-screen bg-slate-100 flex flex-col md:flex-row">

        ```
        <!-- SIDEBAR -->

        <aside class="w-full md:w-64 bg-slate-900 text-white p-5 flex flex-col justify-between shrink-0">

            <div>

                <div class="flex items-center gap-3 mb-8">

                    <div class="w-8 h-8 bg-indigo-500 rounded-lg flex items-center justify-center font-bold">
                        TS
                    </div>

                    <span class="font-bold text-lg">
                        TechStore Admin
                    </span>

                </div>

                <nav class="space-y-1">

                    <a href="/Admin/Dashboard"
                       class="block px-4 py-2.5 rounded-lg text-slate-400 hover:bg-indigo-600 hover:text-white transition">
                        Dashboard
                    </a>

                    <a href="/Usuario/Index"
                       class="block px-4 py-2.5 rounded-lg text-slate-400 hover:bg-indigo-600 hover:text-white transition">
                        Usuarios
                    </a>

                    <a href="/Producto/Index"
                       class="block px-4 py-2.5 rounded-lg text-slate-400 hover:bg-indigo-600 hover:text-white transition">
                        Productos
                    </a>

                    <a href="/Venta/Index"
                       class="block px-4 py-2.5 rounded-lg bg-indigo-600 text-white">
                        Ventas
                    </a>

                    <a href="/Garantia/Index"
                       class="block px-4 py-2.5 rounded-lg text-slate-400 hover:bg-indigo-600 hover:text-white transition">
                        Garantías
                    </a>

                    <a href="/Proveedor/Index"
                       class="block px-4 py-2.5 rounded-lg text-slate-400 hover:bg-indigo-600 hover:text-white transition">
                        Proveedores
                    </a>

                </nav>

            </div>

        </aside>


        <!-- CONTENIDO -->

        <main class="flex-1 p-6">

            <div class="max-w-7xl mx-auto">

                <!-- MENSAJES -->
                @if (TempData["Success"] != null)
                {
                    <div class="mb-5 bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg">
                        @TempData["Success"]
                    </div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="mb-5 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg">
                        @TempData["Error"]
                    </div>
                }


                <!-- ENCABEZADO -->

                <div class="bg-white rounded-xl shadow p-6 mb-6">

                    <div class="flex flex-col md:flex-row md:justify-between md:items-center gap-4">

                        <div>

                            <h1 class="text-2xl font-bold text-slate-900">
                                Venta #@Model.IdVenta
                            </h1>

                            <p class="text-slate-500 mt-1">
                                Detalle de la venta registrada
                            </p>

                        </div>


                        <div class="flex gap-2">

                            @if (Model.Estado != "Cancelada" &&
                                 Model.Estado != "Completada")
                            {
                                <a href="/DetalleVenta/Create?idVenta=@Model.IdVenta"
                                   class="bg-indigo-600 text-white px-4 py-2.5 rounded-lg shadow hover:bg-indigo-700 transition">
                                    + Agregar producto
                                </a>
                            }

                            <a href="/Venta/Edit/@Model.IdVenta"
                               class="bg-slate-700 text-white px-4 py-2.5 rounded-lg hover:bg-slate-800 transition">
                                Editar estado
                            </a>

                            <a href="/Venta/Index"
                               class="px-4 py-2.5 rounded-lg border border-slate-300 text-slate-600 hover:bg-slate-100 transition">
                                Volver
                            </a>

                        </div>

                    </div>

                </div>


                <!-- INFORMACIÓN DE LA VENTA -->

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5 mb-6">

                    <div class="bg-white rounded-xl shadow p-5">

                        <p class="text-sm text-slate-500">
                            Cliente
                        </p>

                        <p class="font-semibold text-slate-900 mt-1">
                            @Model.IdUsuarioNavigation?.Nombre
                            @Model.IdUsuarioNavigation?.Apellidos
                        </p>

                        <p class="text-sm text-slate-500">
                            @Model.IdUsuarioNavigation?.Correo
                        </p>

                    </div>


                    <div class="bg-white rounded-xl shadow p-5">

                        <p class="text-sm text-slate-500">
                            Fecha
                        </p>

                        <p class="font-semibold text-slate-900 mt-1">
                            @Model.Fecha.ToString("dd-MM-yyyy")
                        </p>

                        <p class="text-sm text-slate-500">
                            @Model.Fecha.ToString("HH:mm")
                        </p>

                    </div>


                    <div class="bg-white rounded-xl shadow p-5">

                        <p class="text-sm text-slate-500">
                            Estado
                        </p>

                        <div class="mt-2">

                            @if (Model.Estado == "Pendiente")
                            {
                                <span class="px-3 py-1 rounded-full text-sm bg-yellow-100 text-yellow-700">
                                    Pendiente
                                </span>
                            }
                            else if (Model.Estado == "Completada")
                            {
                                <span class="px-3 py-1 rounded-full text-sm bg-green-100 text-green-700">
                                    Completada
                                </span>
                            }
                            else if (Model.Estado == "Cancelada")
                            {
                                <span class="px-3 py-1 rounded-full text-sm bg-red-100 text-red-700">
                                    Cancelada
                                </span>
                            }

                        </div>

                    </div>


                    <div class="bg-white rounded-xl shadow p-5">

                        <p class="text-sm text-slate-500">
                            Total
                        </p>

                        <p class="text-2xl font-bold text-indigo-600 mt-1">
                            ₡@((Model.Total ?? 0).ToString("N2"))
                        </p>

                    </div>

                </div>


                <!-- PRODUCTOS -->

                <div class="bg-white rounded-xl shadow p-6">

                    <div class="flex justify-between items-center mb-5">

                        <div>

                            <h2 class="text-xl font-bold text-slate-900">
                                Productos de la venta
                            </h2>

                            <p class="text-slate-500 text-sm">
                                Productos incluidos en esta venta
                            </p>

                        </div>

                    </div>


                    @if (Model.DetalleVenta != null &&
                         Model.DetalleVenta.Any())
                    {

                        <div class="overflow-x-auto">

                            <table class="w-full">

                                <thead>

                                    <tr class="border-b border-slate-200">

                                        <th class="text-left py-3 px-4 text-slate-600">
                                            Producto
                                        </th>

                                        <th class="text-center py-3 px-4 text-slate-600">
                                            Cantidad
                                        </th>

                                        <th class="text-right py-3 px-4 text-slate-600">
                                            Precio
                                        </th>

                                        <th class="text-right py-3 px-4 text-slate-600">
                                            Subtotal
                                        </th>

                                        <th class="text-center py-3 px-4 text-slate-600">
                                            Acciones
                                        </th>

                                    </tr>

                                </thead>


                                <tbody>

                                    @foreach (var detalle in Model.DetalleVenta)
                                    {

                                        <tr class="border-b border-slate-100 hover:bg-slate-50">

                                            <td class="py-4 px-4">

                                                <div class="font-semibold text-slate-900">
                                                    @detalle.IdProductoNavigation?.Nombre
                                                </div>

                                            </td>

                                            <td class="py-4 px-4 text-center">
                                                @detalle.Cantidad
                                            </td>

                                            <td class="py-4 px-4 text-right">
                                                ₡@detalle.PrecioUnitario.ToString("N2")
                                            </td>

                                            <td class="py-4 px-4 text-right font-semibold">
                                                ₡@detalle.Subtotal.ToString("N2")
                                            </td>

                                            <td class="py-4 px-4">

                                                <div class="flex justify-center gap-2">

                                                    @if (Model.Estado != "Cancelada" &&
                                                         Model.Estado != "Completada")
                                                    {

                                                        <a href="/DetalleVenta/Edit/@detalle.IdDetalleVenta"
                                                           class="bg-indigo-600 text-white px-3 py-2 rounded-lg hover:bg-indigo-700 transition">
                                                            Editar
                                                        </a>

                                                        <a href="/DetalleVenta/Delete/@detalle.IdDetalleVenta"
                                                           class="bg-red-600 text-white px-3 py-2 rounded-lg hover:bg-red-700 transition">
                                                            Eliminar
                                                        </a>

                                                    }
                                                    else
                                                    {
                                                        <span class="text-sm text-slate-400">
                                                            No disponible
                                                        </span>
                                                    }

                                                </div>

                                            </td>

                                        </tr>

                                    }

                                </tbody>

                            </table>

                        </div>

                    }
                    else
                    {

                        <div class="text-center py-10">

                            <div class="text-5xl mb-4">
                                📦
                            </div>

                            <h3 class="text-lg font-semibold text-slate-800">
                                No hay productos
                            </h3>

                            <p class="text-slate-500 mt-1 mb-5">
                                Esta venta todavía no tiene productos.
                            </p>

                            @if (Model.Estado != "Cancelada" &&
                                 Model.Estado != "Completada")
                            {
                                <a href="/DetalleVenta/Create?idVenta=@Model.IdVenta"
                                   class="bg-indigo-600 text-white px-5 py-2.5 rounded-lg hover:bg-indigo-700 transition">
                                    + Agregar producto
                                </a>
                            }

                        </div>

                    }


                    <!-- RESUMEN -->

                    <div class="flex justify-end mt-6">

                        <div class="w-full md:w-80 border-t border-slate-200 pt-4">

                            <div class="flex justify-between py-2">

                                <span class="text-slate-500">
                                    Impuesto
                                </span>

                                <span>
                                    ₡@((Model.Impuesto ?? 0).ToString("N2"))
                                </span>

                            </div>

                            <div class="flex justify-between py-2">

                                <span class="text-slate-500">
                                    Descuento
                                </span>

                                <span>
                                    ₡@((Model.Descuento ?? 0).ToString("N2"))
                                </span>

                            </div>

                            <div class="flex justify-between border-t border-slate-200 pt-3 mt-2">

                                <span class="font-bold text-slate-900">
                                    TOTAL
                                </span>

                                <span class="font-bold text-xl text-indigo-600">
                                    ₡@((Model.Total ?? 0).ToString("N2"))
                                </span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </main>
        ```

    </div>

</body>

</html>
