@model TechStore.Models.Carrito

@{
    ViewData["Title"] = "Mi Carrito";


decimal total = Model.DetalleCarritos
    .Sum(item => item.Cantidad * item.IdProductoNavigation.Precio);


}

<!DOCTYPE html>

<html lang="es">

<head>

    <meta charset="utf-8" />

    <title>
        @ViewData["Title"] - TechStore
    </title>

    <script src="https://cdn.tailwindcss.com"></script>


</head>

<body class="bg-slate-100 min-h-screen">

    <!-- ===================================================== -->
    <!-- NAVBAR -->
    <!-- ===================================================== -->

    <nav class="bg-slate-900 text-white shadow-lg">

        <div class="max-w-7xl mx-auto px-6 py-4">

            <div class="flex flex-col md:flex-row
                md:items-center md:justify-between gap-4">


                <!-- LOGO -->

                <a href="/Cliente/Catalogo"
                   class="flex items-center gap-3">

                    <div class="w-9 h-9 bg-indigo-500 rounded-lg
                        flex items-center justify-center
                        font-bold">

                        TS

                    </div>

                    <span class="font-bold text-xl">
                        TechStore
                    </span>

                </a>


                <!-- NAVEGACIÓN -->

                <div class="flex flex-wrap items-center gap-2">

                    <a href="/Cliente/Catalogo"
                       class="px-4 py-2 rounded-lg
                        text-slate-300
                        hover:bg-slate-800
                        hover:text-white transition">

                        Productos

                    </a>


                    <a href="/Carrito/Index"
                       class="px-4 py-2 rounded-lg
                        bg-indigo-600 text-white">

                        🛒 Carrito

                    </a>


                    <a href="/Venta/Index"
                       class="px-4 py-2 rounded-lg
                        text-slate-300
                        hover:bg-slate-800
                        hover:text-white transition">

                        Mis compras

                    </a>


                    <a href="/Garantia/Index"
                       class="px-4 py-2 rounded-lg
                        text-slate-300
                        hover:bg-slate-800
                        hover:text-white transition">

                        Garantías

                    </a>


                    <form action="/Account/Logout"
                          method="post"
                          class="inline">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="px-4 py-2 rounded-lg
                            text-rose-400
                            hover:bg-rose-500
                            hover:text-white transition">

                            Salir

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </nav>



    <!-- ===================================================== -->
    <!-- CONTENIDO -->
    <!-- ===================================================== -->

    <main class="max-w-7xl mx-auto px-6 py-8">


        <!-- ================================================= -->
        <!-- ENCABEZADO -->
        <!-- ================================================= -->

        <div class="mb-8">

            <h1 class="text-3xl font-extrabold text-slate-900">

                Mi Carrito

            </h1>

            <p class="text-slate-500 mt-2">

                Revisa tus productos antes de realizar la compra.

            </p>

        </div>



        <!-- ================================================= -->
        <!-- MENSAJE ÉXITO -->
        <!-- ================================================= -->
        @if (TempData["Success"] != null)
        {
            <div class="mb-6 bg-green-50
                border border-green-200
                text-green-700
                px-5 py-4 rounded-lg">

                <div class="flex items-center gap-2">

                    <span class="font-bold">
                        ✓
                    </span>

                    <span>
                        @TempData["Success"]
                    </span>

                </div>

            </div>
        }



        <!-- ================================================= -->
        <!-- MENSAJE ERROR -->
        <!-- ================================================= -->
        @if (TempData["Error"] != null)
        {
            <div class="mb-6 bg-red-50
                border border-red-200
                text-red-700
                px-5 py-4 rounded-lg">

                <div class="flex items-center gap-2">

                    <span class="font-bold">
                        !
                    </span>

                    <span>
                        @TempData["Error"]
                    </span>

                </div>

            </div>
        }



        <!-- ================================================= -->
        <!-- CARRITO VACÍO -->
        <!-- ================================================= -->
        @if (!Model.DetalleCarritos.Any())
        {

            <div class="bg-white rounded-xl shadow
                p-12 text-center">

                <div class="text-6xl mb-5">
                    🛒
                </div>


                <h2 class="text-2xl font-bold
                    text-slate-900 mb-2">

                    Tu carrito está vacío

                </h2>


                <p class="text-slate-500 mb-6">

                    Agrega productos desde nuestro catálogo
                    para comenzar tu compra.

                </p>


                <a href="/Cliente/Catalogo"
                   class="inline-block
                    bg-indigo-600
                    text-white
                    px-6 py-3
                    rounded-lg
                    font-semibold
                    shadow
                    hover:bg-indigo-700
                    transition">

                    Ver productos

                </a>

            </div>

        }

        else
        {

            <!-- ================================================= -->
            <!-- PRODUCTOS + RESUMEN -->
            <!-- ================================================= -->

            <div class="grid grid-cols-1
                lg:grid-cols-3 gap-6">


                <!-- ================================================= -->
                <!-- PRODUCTOS -->
                <!-- ================================================= -->

                <div class="lg:col-span-2
                    bg-white
                    rounded-xl
                    shadow
                    overflow-hidden">


                    <!-- CABECERA -->

                    <div class="px-6 py-5
                        border-b border-slate-200">

                        <h2 class="text-xl font-bold
                            text-slate-900">

                            Productos en tu carrito

                        </h2>

                        <p class="text-sm
                            text-slate-500 mt-1">

                            @Model.DetalleCarritos.Count producto(s)

                        </p>

                    </div>



                    <!-- LISTA -->

                    <div class="divide-y
                        divide-slate-200">

                        @foreach (var item in Model.DetalleCarritos)
                        {

                            var subtotal =
                                item.Cantidad *
                                item.IdProductoNavigation.Precio;


                            <div class="p-6
                                flex flex-col
                                md:flex-row
                                md:items-center
                                gap-5">


                                <!-- IMAGEN -->

                                <div class="w-24 h-24
                                    bg-slate-100
                                    rounded-lg
                                    flex items-center
                                    justify-center
                                    shrink-0">

                                    <span class="text-4xl">
                                        🖥️
                                    </span>

                                </div>



                                <!-- INFORMACIÓN -->

                                <div class="flex-1">

                                    <h3 class="text-lg
                                        font-bold
                                        text-slate-900">

                                        @item.IdProductoNavigation.Nombre

                                    </h3>


                                    <p class="text-sm
                                        text-slate-500 mt-1">

                                        Precio unitario:
                                        ₡@item.IdProductoNavigation.Precio.ToString("N2")

                                    </p>


                                    <div class="mt-3
                                        flex items-center
                                        gap-3">

                                        <span class="text-sm
                                            font-semibold
                                            text-slate-700">

                                            Cantidad:

                                        </span>


                                        <span class="px-3 py-1
                                            rounded-lg
                                            bg-slate-100
                                            text-slate-800
                                            font-semibold">

                                            @item.Cantidad

                                        </span>

                                    </div>

                                </div>



                                <!-- SUBTOTAL -->

                                <div class="text-left
                                    md:text-right">

                                    <p class="text-xs
                                        text-slate-500
                                        uppercase
                                        font-semibold">

                                        Subtotal

                                    </p>


                                    <p class="text-xl
                                        font-extrabold
                                        text-slate-900
                                        mt-1">

                                        ₡@subtotal.ToString("N2")

                                    </p>

                                </div>



                                <!-- ELIMINAR -->

                                <div>

                                    <form action="/Carrito/QuitarProducto"
                                          method="post">

                                        @Html.AntiForgeryToken()


                                        <input type="hidden"
                                               name="productoId"
                                               value="@item.IdProducto" />


                                        <button type="submit"
                                                class="px-3 py-2
                                            rounded-lg
                                            bg-red-50
                                            text-red-600
                                            hover:bg-red-100
                                            transition">

                                            🗑️

                                        </button>

                                    </form>

                                </div>

                            </div>

                        }

                    </div>

                </div>



                <!-- ================================================= -->
                <!-- RESUMEN DE COMPRA -->
                <!-- ================================================= -->

                <div class="lg:col-span-1">

                    <div class="bg-white
                        rounded-xl
                        shadow
                        p-6
                        sticky top-6">


                        <h2 class="text-xl
                            font-bold
                            text-slate-900
                            mb-6">

                            Resumen de compra

                        </h2>


                        <!-- CANTIDAD -->

                        <div class="flex
                            justify-between
                            text-slate-600
                            mb-3">

                            <span>
                                Productos
                            </span>

                            <span class="font-semibold">

                                @Model.DetalleCarritos.Sum(x => x.Cantidad)

                            </span>

                        </div>


                        <!-- TOTAL -->

                        <div class="border-t
                            border-slate-200
                            pt-5
                            mt-5">

                            <div class="flex
                                justify-between
                                items-center">

                                <span class="text-lg
                                    font-semibold
                                    text-slate-700">

                                    Total

                                </span>


                                <span class="text-2xl
                                    font-extrabold
                                    text-slate-900">

                                    ₡@total.ToString("N2")

                                </span>

                            </div>

                        </div>



                        <!-- CONFIRMAR COMPRA -->

                        <form action="/Carrito/ConfirmarCompra"
                              method="post"
                              class="mt-6">

                            @Html.AntiForgeryToken()


                            <button type="submit"
                                    class="w-full
                                bg-indigo-600
                                text-white
                                px-5 py-3
                                rounded-lg
                                font-semibold
                                shadow
                                hover:bg-indigo-700
                                transition">

                                🛒 Confirmar compra

                            </button>

                        </form>



                        <!-- CONTINUAR COMPRANDO -->

                        <a href="/Cliente/Catalogo"
                           class="block
                            w-full
                            text-center
                            mt-3
                            px-5 py-3
                            rounded-lg
                            border
                            border-slate-300
                            text-slate-700
                            hover:bg-slate-100
                            transition">

                            Seguir comprando

                        </a>


                    </div>

                </div>

            </div>

        }

    </main>

</body>

</html>
