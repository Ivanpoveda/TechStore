@model TechStore.Models.DetalleVentum

@{
    ViewData["Title"] = "Detalle de Venta";
}

<!DOCTYPE html>

<html lang="es">

<head>

    ```
    <meta charset="utf-8" />

    <title>
        @ViewData["Title"] - TechStore
    </title>

    <script src="https://cdn.tailwindcss.com"></script>
    ```

</head>

<body class="bg-slate-100 min-h-screen">

    <div class="min-h-screen flex flex-col md:flex-row">

        ```
        <!-- SIDEBAR -->

        <aside class="w-full md:w-64 bg-slate-900 text-white p-5 shrink-0">

            <div class="flex items-center gap-3 mb-8">

                <div class="w-8 h-8 bg-indigo-500 rounded-lg flex items-center justify-center font-bold">
                    TS
                </div>

                <span class="font-bold text-lg">
                    TechStore Admin
                </span>

            </div>

            <nav class="space-y-1">

                <a href="/Admin/Dashboard"
                   class="block px-4 py-2.5 rounded-lg text-slate-400 hover:bg-indigo-600 hover:text-white transition">
                    Dashboard
                </a>

                <a href="/Usuario/Index"
                   class="block px-4 py-2.5 rounded-lg text-slate-400 hover:bg-indigo-600 hover:text-white transition">
                    Usuarios
                </a>

                <a href="/Producto/Index"
                   class="block px-4 py-2.5 rounded-lg text-slate-400 hover:bg-indigo-600 hover:text-white transition">
                    Productos
                </a>

                <a href="/Venta/Index"
                   class="block px-4 py-2.5 rounded-lg bg-indigo-600 text-white">
                    Ventas
                </a>

                <a href="/Garantia/Index"
                   class="block px-4 py-2.5 rounded-lg text-slate-400 hover:bg-indigo-600 hover:text-white transition">
                    Garantías
                </a>

                <a href="/Proveedor/Index"
                   class="block px-4 py-2.5 rounded-lg text-slate-400 hover:bg-indigo-600 hover:text-white transition">
                    Proveedores
                </a>

            </nav>

        </aside>


        <main class="flex-1 p-6">

            <div class="max-w-2xl mx-auto">

                <div class="bg-white rounded-xl shadow p-6">

                    <h1 class="text-2xl font-bold text-slate-900">
                        Detalle #@Model.IdDetalleVenta
                    </h1>

                    <p class="text-slate-500 mt-1 mb-6">
                        Información del producto vendido.
                    </p>


                    <div class="space-y-4">

                        <div class="border-b border-slate-100 pb-4">

                            <p class="text-sm text-slate-500">
                                Venta
                            </p>

                            <p class="font-semibold text-slate-900">
                                #@Model.IdVenta
                            </p>

                        </div>


                        <div class="border-b border-slate-100 pb-4">

                            <p class="text-sm text-slate-500">
                                Cliente
                            </p>

                            <p class="font-semibold text-slate-900">

                                @Model.IdVentaNavigation?.IdUsuarioNavigation?.Nombre
                                @Model.IdVentaNavigation?.IdUsuarioNavigation?.Apellidos

                            </p>

                        </div>


                        <div class="border-b border-slate-100 pb-4">

                            <p class="text-sm text-slate-500">
                                Producto
                            </p>

                            <p class="font-semibold text-slate-900">
                                @Model.IdProductoNavigation?.Nombre
                            </p>

                        </div>


                        <div class="grid grid-cols-2 gap-4">

                            <div class="bg-slate-50 rounded-lg p-4">

                                <p class="text-sm text-slate-500">
                                    Cantidad
                                </p>

                                <p class="text-xl font-bold text-slate-900">
                                    @Model.Cantidad
                                </p>

                            </div>


                            <div class="bg-slate-50 rounded-lg p-4">

                                <p class="text-sm text-slate-500">
                                    Precio unitario
                                </p>

                                <p class="text-xl font-bold text-slate-900">
                                    ₡@Model.PrecioUnitario.ToString("N2")
                                </p>

                            </div>

                        </div>


                        <div class="bg-indigo-50 rounded-lg p-5">

                            <p class="text-sm text-indigo-600">
                                Subtotal
                            </p>

                            <p class="text-2xl font-bold text-indigo-700">
                                ₡@Model.Subtotal.ToString("N2")
                            </p>

                        </div>

                    </div>


                    <div class="flex justify-end gap-3 mt-6">

                        @if (Model.IdVentaNavigation?.Estado != "Cancelada" &&
                             Model.IdVentaNavigation?.Estado != "Completada")
                        {
                            <a href="/DetalleVenta/Edit/@Model.IdDetalleVenta"
                               class="bg-indigo-600 text-white px-5 py-2.5 rounded-lg hover:bg-indigo-700">
                                Editar
                            </a>

                            <a href="/DetalleVenta/Delete/@Model.IdDetalleVenta"
                               class="bg-red-600 text-white px-5 py-2.5 rounded-lg hover:bg-red-700">
                                Eliminar
                            </a>
                        }

                        <a href="/Venta/Details/@Model.IdVenta"
                           class="px-5 py-2.5 rounded-lg border border-slate-300 text-slate-600 hover:bg-slate-100">
                            Volver
                        </a>

                    </div>

                </div>

            </div>

        </main>
        ```

    </div>

</body>

</html>
