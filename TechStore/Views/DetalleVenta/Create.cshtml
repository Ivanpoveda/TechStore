@model TechStore.Models.DetalleVentum

@{
    ViewData["Title"] = "Agregar Producto";
}

<meta charset="utf-8" />

<title>
    @ViewData["Title"] - TechStore
</title>

<script src="https://cdn.tailwindcss.com"></script>

<div class="min-h-screen flex flex-col md:flex-row bg-slate-100">

    <!-- ===================================================== -->
    <!-- SIDEBAR -->
    <!-- ===================================================== -->

    <aside class="w-full md:w-64 bg-slate-900 text-white p-5 shrink-0">

        <div class="flex items-center gap-3 mb-8">

            <div class="w-8 h-8 bg-indigo-500 rounded-lg flex items-center justify-center font-bold">
                TS
            </div>

            <span class="font-bold text-lg">
                TechStore Admin
            </span>

        </div>

        <nav class="space-y-1">

            <a href="/Admin/Dashboard"
               class="block px-4 py-2.5 rounded-lg text-slate-400 hover:bg-indigo-600 hover:text-white transition">
                Dashboard
            </a>

            <a href="/Usuario/Index"
               class="block px-4 py-2.5 rounded-lg text-slate-400 hover:bg-indigo-600 hover:text-white transition">
                Usuarios
            </a>

            <a href="/Producto/Index"
               class="block px-4 py-2.5 rounded-lg text-slate-400 hover:bg-indigo-600 hover:text-white transition">
                Productos
            </a>

            <a href="/Venta/Index"
               class="block px-4 py-2.5 rounded-lg bg-indigo-600 text-white">
                Ventas
            </a>

            <a href="/Garantia/Index"
               class="block px-4 py-2.5 rounded-lg text-slate-400 hover:bg-indigo-600 hover:text-white transition">
                Garantías
            </a>

            <a href="/Proveedor/Index"
               class="block px-4 py-2.5 rounded-lg text-slate-400 hover:bg-indigo-600 hover:text-white transition">
                Proveedores
            </a>

        </nav>

    </aside>


    <!-- ===================================================== -->
    <!-- CONTENIDO -->
    <!-- ===================================================== -->

    <main class="flex-1 p-6">

        <div class="max-w-2xl mx-auto">

            <div class="bg-white rounded-xl shadow p-6">

                <!-- ENCABEZADO -->

                <h1 class="text-2xl font-bold text-slate-900">
                    Agregar Producto
                </h1>

                <p class="text-slate-500 mt-1 mb-6">
                    Agrega un producto a la venta
                    <strong>#@Model.IdVenta</strong>.
                </p>


                <!-- ================================================= -->
                <!-- MENSAJE DE ERROR -->
                <!-- ================================================= -->
                @if (TempData["Error"] != null)
                {
                    <div class="mb-5 bg-red-50 border border-red-200
                        text-red-700 px-4 py-3 rounded-lg">

                        @TempData["Error"]

                    </div>
                }


                <!-- ================================================= -->
                <!-- VALIDACIONES -->
                <!-- ================================================= -->
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="mb-5 bg-red-50 border border-red-200
                        text-red-700 px-4 py-3 rounded-lg">

                        <ul class="list-disc list-inside text-sm">

                            @foreach (var error in ViewData.ModelState.Values
                                .SelectMany(v => v.Errors))
                            {
                                <li>
                                    @error.ErrorMessage
                                </li>
                            }

                        </ul>

                    </div>
                }


                <!-- ================================================= -->
                <!-- FORMULARIO -->
                <!-- ================================================= -->

                <form action="/DetalleVenta/Create"
                      method="post">

                    @Html.AntiForgeryToken()


                    <!-- ================================================= -->
                    <!-- VENTA -->
                    <!-- ================================================= -->

                    <div class="mb-5">

                        <label class="block font-semibold text-slate-700 mb-2">
                            Venta
                        </label>

                        <!-- La venta ya viene seleccionada -->
                        <input type="hidden"
                               name="IdVenta"
                               value="@Model.IdVenta" />

                        <div class="w-full bg-slate-100 border border-slate-300
                            rounded-lg px-3 py-2.5 text-slate-700">

                            Venta #@Model.IdVenta

                        </div>

                    </div>


                    <!-- ================================================= -->
                    <!-- PRODUCTO -->
                    <!-- ================================================= -->

                    <div class="mb-5">

                        <label for="IdProducto"
                               class="block font-semibold text-slate-700 mb-2">

                            Producto

                        </label>

                        <select id="IdProducto"
                                name="IdProducto"
                                required
                                class="w-full border border-slate-300
                            rounded-lg px-3 py-2.5
                            focus:ring-2 focus:ring-indigo-500
                            focus:outline-none">

                            <option value="">
                                -- Seleccione un producto --
                            </option>

                            @if (ViewData["IdProducto"] is SelectList productos)
                            {
                                foreach (var producto in productos)
                                {
                                    <option value="@producto.Value"
                                            selected="@(producto.Selected ? "selected" : null)">

                                        @producto.Text

                                    </option>
                                }
                            }

                        </select>

                    </div>


                    <!-- ================================================= -->
                    <!-- CANTIDAD -->
                    <!-- ================================================= -->

                    <div class="mb-6">

                        <label for="Cantidad"
                               class="block font-semibold text-slate-700 mb-2">

                            Cantidad

                        </label>

                        <input type="number"
                               id="Cantidad"
                               name="Cantidad"
                               value="@(Model.Cantidad > 0 ? Model.Cantidad : 1)"
                               min="1"
                               required
                               class="w-full border border-slate-300
                        rounded-lg px-3 py-2.5
                        focus:ring-2 focus:ring-indigo-500
                        focus:outline-none" />

                        <p class="text-xs text-slate-500 mt-1">
                            La cantidad no puede superar el stock disponible.
                        </p>

                    </div>


                    <!-- ================================================= -->
                    <!-- INFORMACIÓN -->
                    <!-- ================================================= -->

                    <div class="bg-blue-50 border border-blue-200
                        text-blue-700 px-4 py-3 rounded-lg
                        mb-6 text-sm">

                        <p>
                            El precio se obtiene automáticamente del producto.
                        </p>

                        <p>
                            El subtotal será calculado por SQL Server.
                        </p>

                        <p>
                            El stock será descontado automáticamente al registrar
                            el detalle.
                        </p>

                    </div>


                    <!-- ================================================= -->
                    <!-- BOTONES -->
                    <!-- ================================================= -->

                    <div class="flex justify-end gap-3">

                        <a href="/Venta/Details/@Model.IdVenta"
                           class="px-5 py-2.5 rounded-lg
                            border border-slate-300
                            text-slate-600
                            hover:bg-slate-100
                            transition">

                            Cancelar

                        </a>

                        <button type="submit"
                                class="bg-indigo-600 text-white
                            px-5 py-2.5 rounded-lg
                            shadow hover:bg-indigo-700
                            transition">

                            Agregar Producto

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </main>

</div>
