@model TechStore.Models.CompraProveedor

@{
    ViewData["Title"] = "Nueva compra a proveedor";
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Nueva compra - TechStore</title>

    <script src="https://cdn.tailwindcss.com"></script>

</head>

<body class="bg-slate-100 min-h-screen">

    <div class="min-h-screen flex flex-col md:flex-row">

        <!-- SIDEBAR -->

        <aside class="w-full md:w-64 bg-slate-900 text-white p-5 shrink-0">

            <div class="flex items-center gap-3 mb-8">

                <div class="w-8 h-8 bg-indigo-500 rounded-lg
                    flex items-center justify-center font-bold">
                    TS
                </div>

                <span class="font-bold text-lg">
                    TechStore Admin
                </span>

            </div>

            <nav class="space-y-1">

                <a href="/Admin/Dashboard"
                   class="block px-4 py-2.5 rounded-lg
                    text-slate-400 hover:bg-indigo-600
                    hover:text-white transition">
                    Dashboard
                </a>

                <a href="/Producto/Index"
                   class="block px-4 py-2.5 rounded-lg
                    text-slate-400 hover:bg-indigo-600
                    hover:text-white transition">
                    Productos
                </a>

                <a href="/Venta/Index"
                   class="block px-4 py-2.5 rounded-lg
                    text-slate-400 hover:bg-indigo-600
                    hover:text-white transition">
                    Ventas
                </a>

                <a href="/Proveedor/Index"
                   class="block px-4 py-2.5 rounded-lg
                    text-slate-400 hover:bg-indigo-600
                    hover:text-white transition">
                    Proveedores
                </a>

                <a href="/CompraProveedor/Index"
                   class="block px-4 py-2.5 rounded-lg
                    bg-indigo-600 text-white">
                    Compras a proveedores
                </a>

            </nav>

        </aside>


        <!-- CONTENIDO -->

        <main class="flex-1 p-6">

            <div class="max-w-4xl mx-auto">

                <div class="mb-6">

                    <h1 class="text-2xl font-bold text-slate-900">
                        Nueva compra a proveedor
                    </h1>

                    <p class="text-slate-500 mt-1">
                        Registra una compra de productos para abastecer
                        el inventario de TechStore.
                    </p>

                </div>


                @if (TempData["Error"] != null)
                {
                    <div class="mb-5 bg-red-50 border border-red-200
                        text-red-700 px-4 py-3 rounded-lg">

                        @TempData["Error"]

                    </div>
                }


                <div class="bg-white rounded-xl shadow-sm
                    border border-slate-200 p-6">

                    <form asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()


                        <!-- PROVEEDOR -->
                        
                        <div class="mb-5">

                            <label for="IdProveedor"
                                   class="block text-sm font-semibold text-slate-700 mb-2">
                                Proveedor
                            </label>

                            <select id="IdProveedor"
                                    name="IdProveedor"
                                    required
                                    class="w-full px-4 py-3
                                border border-slate-300
                                rounded-lg
                                focus:ring-2
                                focus:ring-indigo-500
                                outline-none">

                                <option value="">
                                    Seleccione un proveedor
                                </option>

                                @if (ViewBag.IdProveedor != null)
                                {
                                    foreach (var proveedor in ViewBag.IdProveedor)
                                    {
                                        <option value="@proveedor.Value">
                                            @proveedor.Text
                                        </option>
                                    }
                                }

                            </select>

                        </div>


                        <!-- PRODUCTO -->

                        <div class="mb-5">

                            <label for="IdProducto"
                                   class="block text-sm font-semibold
                                text-slate-700 mb-2">

                                Producto

                            </label>

                            <select id="IdProducto"
                                    name="IdProducto"
                                    required
                                    class="w-full px-4 py-3
                                border border-slate-300
                                rounded-lg
                                focus:ring-2
                                focus:ring-indigo-500
                                outline-none">

                                <option value="">
                                    Seleccione un producto
                                </option>

                                @if (ViewBag.IdProducto != null)
                                {
                                    foreach (var producto in ViewBag.IdProducto)
                                    {
                                        <option value="@producto.Value">
                                            @producto.Text
                                        </option>
                                    }
                                }

                            </select>

                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">


                            <!-- CANTIDAD -->

                            <div>

                                <label class="block text-sm font-semibold
                                    text-slate-700 mb-2">

                                    Cantidad

                                </label>

                                <input type="number"
                                       name="Cantidad"
                                       min="1"
                                       required
                                       placeholder="Ej. 10"
                                       class="w-full px-4 py-3
                                border border-slate-300
                                rounded-lg
                                focus:ring-2
                                focus:ring-indigo-500
                                outline-none" />

                            </div>


                            <!-- PRECIO -->

                            <div>

                                <label class="block text-sm font-semibold
                                    text-slate-700 mb-2">

                                    Precio de compra por unidad

                                </label>

                                <input type="number"
                                       name="PrecioCompra"
                                       min="0.01"
                                       step="0.01"
                                       required
                                       placeholder="Ej. 50000"
                                       class="w-full px-4 py-3
                                border border-slate-300
                                rounded-lg
                                focus:ring-2
                                focus:ring-indigo-500
                                outline-none" />

                            </div>

                        </div>


                        <!-- INFORMACIÓN -->

                        <div class="mt-6 p-4 bg-indigo-50
                            border border-indigo-100 rounded-lg">

                            <p class="text-sm text-indigo-700">

                                <strong>Importante:</strong>

                                El stock del producto no aumentará
                                inmediatamente. Se actualizará cuando
                                la compra sea marcada como
                                <strong>Recibida</strong>.

                            </p>

                        </div>


                        <!-- BOTONES -->

                        <div class="mt-6 flex justify-end gap-3">

                            <a href="/CompraProveedor/Index"
                               class="px-5 py-3 rounded-lg
                                border border-slate-300
                                text-slate-700
                                hover:bg-slate-100">

                                Cancelar

                            </a>

                            <button type="submit"
                                    class="px-5 py-3 rounded-lg
                                bg-indigo-600 text-white
                                font-medium
                                hover:bg-indigo-700">

                                Crear compra

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </main>

    </div>

</body>
</html>