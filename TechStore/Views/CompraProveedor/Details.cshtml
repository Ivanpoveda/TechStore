@model IEnumerable<TechStore.Models.CompraProveedor>

@{
    ViewData["Title"] = "Compras a proveedores";
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Compras a proveedores - TechStore</title>

    <script src="https://cdn.tailwindcss.com"></script>

</head>

<body class="bg-slate-100 min-h-screen">

    <div class="min-h-screen flex flex-col md:flex-row">


        <!-- SIDEBAR -->

        <aside class="w-full md:w-64 bg-slate-900
            text-white p-5 shrink-0">

            <!-- LOGO -->

            <div class="flex items-center gap-3 mb-8">

                <div class="w-8 h-8 bg-indigo-500 rounded-lg
                    flex items-center justify-center font-bold">

                    TS

                </div>

                <span class="font-bold text-lg">

                    TechStore Admin

                </span>

            </div>


            <!-- MENU -->

            <nav class="space-y-1">

                <a href="/Admin/Dashboard"
                   class="block px-4 py-2.5 rounded-lg
                    text-slate-400 hover:bg-indigo-600
                    hover:text-white">

                    Dashboard

                </a>

                <a href="/Producto/Index"
                   class="block px-4 py-2.5 rounded-lg
                    text-slate-400 hover:bg-indigo-600
                    hover:text-white">

                    Productos

                </a>

                <a href="/Venta/Index"
                   class="block px-4 py-2.5 rounded-lg
                    text-slate-400 hover:bg-indigo-600
                    hover:text-white">

                    Ventas

                </a>

                <a href="/Proveedor/Index"
                   class="block px-4 py-2.5 rounded-lg
                    text-slate-400 hover:bg-indigo-600
                    hover:text-white">

                    Proveedores

                </a>

                <a href="/CompraProveedor/Index"
                   class="block px-4 py-2.5 rounded-lg
                    bg-indigo-600 text-white">

                    Compras a proveedores

                </a>

            </nav>

        </aside>


        <!-- CONTENIDO -->

        <main class="flex-1 p-6">

            <div class="max-w-7xl mx-auto">


                <!-- ENCABEZADO -->

                <div class="flex flex-col md:flex-row
                    md:items-center
                    md:justify-between mb-6">

                    <div>

                        <h1 class="text-2xl font-bold text-slate-900">

                            Compras a proveedores

                        </h1>

                        <p class="text-slate-500 mt-1">

                            Gestión de compras realizadas a proveedores

                        </p>

                    </div>


                    <!-- NUEVA COMPRA -->

                    <a href="/CompraProveedor/Create"
                       class="mt-4 md:mt-0
                        px-4 py-2 rounded-lg
                        bg-indigo-600 text-white
                        hover:bg-indigo-700">

                        + Nueva compra

                    </a>

                </div>


                <!-- MENSAJE EXITOSO -->
                @if (TempData["Success"] != null)
                {
                    <div class="mb-5 bg-green-50
                        border border-green-200
                        text-green-700
                        px-4 py-3 rounded-lg">

                        @TempData["Success"]

                    </div>
                }


                <!-- MENSAJE DE ERROR -->
                @if (TempData["Error"] != null)
                {
                    <div class="mb-5 bg-red-50
                        border border-red-200
                        text-red-700
                        px-4 py-3 rounded-lg">

                        @TempData["Error"]

                    </div>
                }


                <!-- TABLA -->

                <div class="bg-white rounded-xl
                    shadow-sm border border-slate-200
                    overflow-hidden">

                    <div class="overflow-x-auto">

                        <table class="w-full text-sm text-left">

                            <!-- CABECERA -->

                            <thead class="bg-slate-50
                                border-b border-slate-200">

                                <tr>

                                    <th class="px-5 py-4
                                        text-slate-600
                                        font-semibold">

                                        Compra

                                    </th>

                                    <th class="px-5 py-4
                                        text-slate-600
                                        font-semibold">

                                        Fecha

                                    </th>

                                    <th class="px-5 py-4
                                        text-slate-600
                                        font-semibold">

                                        Proveedor

                                    </th>

                                    <th class="px-5 py-4
                                        text-slate-600
                                        font-semibold">

                                        Total

                                    </th>

                                    <th class="px-5 py-4
                                        text-slate-600
                                        font-semibold">

                                        Estado

                                    </th>

                                    <th class="px-5 py-4
                                        text-slate-600
                                        font-semibold">

                                        Acciones

                                    </th>

                                </tr>

                            </thead>


                            <!-- CUERPO -->

                            <tbody class="divide-y
                                divide-slate-100">

                                @if (Model != null && Model.Any())
                                {
                                    foreach (var item in Model)
                                    {
                                        <tr class="hover:bg-slate-50">


                                            <!-- ID COMPRA -->

                                            <td class="px-5 py-4">

                                                <span class="font-bold
                                                    text-slate-900">

                                                    #@item.IdCompra

                                                </span>

                                            </td>


                                            <!-- FECHA -->

                                            <td class="px-5 py-4
                                                text-slate-600">

                                                @item.FechaCompra.ToString("dd-MM-yyyy")

                                            </td>


                                            <!-- PROVEEDOR -->

                                            <td class="px-5 py-4">

                                                <span class="font-semibold
                                                    text-slate-900">

                                                    @item.IdProveedorNavigation?.Nombre

                                                </span>

                                            </td>


                                            <!-- TOTAL -->

                                            <td class="px-5 py-4">

                                                <span class="font-bold
                                                    text-slate-900">

                                                    ₡@((item.Total ?? 0).ToString("N2"))

                                                </span>

                                            </td>


                                            <!-- ESTADO -->

                                            <td class="px-5 py-4">

                                                @if (item.Estado == "Recibida")
                                                {
                                                    <span class="inline-block
                                                        px-3 py-1
                                                        rounded-full
                                                        bg-green-100
                                                        text-green-700
                                                        font-semibold">

                                                        Recibida

                                                    </span>
                                                }
                                                else if (item.Estado == "Cancelada")
                                                {
                                                    <span class="inline-block
                                                        px-3 py-1
                                                        rounded-full
                                                        bg-red-100
                                                        text-red-700
                                                        font-semibold">

                                                        Cancelada

                                                    </span>
                                                }
                                                else if (item.Estado == "En proceso")
                                                {
                                                    <span class="inline-block
                                                        px-3 py-1
                                                        rounded-full
                                                        bg-blue-100
                                                        text-blue-700
                                                        font-semibold">

                                                        En proceso

                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="inline-block
                                                        px-3 py-1
                                                        rounded-full
                                                        bg-yellow-100
                                                        text-yellow-700
                                                        font-semibold">

                                                        @item.Estado

                                                    </span>
                                                }

                                            </td>


                                            <!-- ACCIONES -->

                                            <td class="px-5 py-4">

                                                <div class="flex
                                                    items-center gap-2">


                                                    <!-- VER -->

                                                    <a href="/CompraProveedor/Details/@item.IdCompra"
                                                       class="px-3 py-1.5
                                                        rounded-lg
                                                        border
                                                        border-slate-300
                                                        text-slate-700
                                                        hover:bg-slate-100">

                                                        Ver

                                                    </a>


                                                    <!-- EDITAR -->
                                                    @if (item.Estado != "Recibida" &&
                                                                                                             item.Estado != "Cancelada")
                                                    {
                                                        <a href="/CompraProveedor/Edit/@item.IdCompra"
                                                           class="px-3 py-1.5
                                                            rounded-lg
                                                            bg-indigo-600
                                                            text-white
                                                            hover:bg-indigo-700">

                                                            Editar

                                                        </a>
                                                    }

                                                </div>

                                            </td>

                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>

                                        <td colspan="6"
                                            class="px-5 py-12
                                            text-center">

                                            <div class="text-slate-400
                                                mb-2">

                                                No hay compras registradas.

                                            </div>

                                            <a href="/CompraProveedor/Create"
                                               class="text-indigo-600
                                                hover:text-indigo-800
                                                font-semibold">

                                                Registrar una compra

                                            </a>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </main>

    </div>

</body>

</html>