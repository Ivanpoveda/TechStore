@model TechStore.Models.CompraProveedor

@{
    ViewData["Title"] = "Detalle de compra";

    var detalles =
        ViewBag.Detalles as IEnumerable<TechStore.Models.DetalleCompra>
        ?? Enumerable.Empty<TechStore.Models.DetalleCompra>();
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Detalle de compra - TechStore</title>

    <script src="https://cdn.tailwindcss.com"></script>

</head>

<body class="bg-slate-100 min-h-screen">

    <div class="min-h-screen flex flex-col md:flex-row">


        <!-- SIDEBAR -->

        <aside class="w-full md:w-64 bg-slate-900
            text-white p-5 shrink-0">

            <div class="flex items-center gap-3 mb-8">

                <div class="w-8 h-8 bg-indigo-500 rounded-lg
                    flex items-center justify-center font-bold">

                    TS

                </div>

                <span class="font-bold text-lg">
                    TechStore Admin
                </span>

            </div>


            <nav class="space-y-1">

                <a href="/Admin/Dashboard"
                   class="block px-4 py-2.5 rounded-lg
                    text-slate-400 hover:bg-indigo-600
                    hover:text-white">

                    Dashboard

                </a>

                <a href="/Producto/Index"
                   class="block px-4 py-2.5 rounded-lg
                    text-slate-400 hover:bg-indigo-600
                    hover:text-white">

                    Productos

                </a>

                <a href="/Venta/Index"
                   class="block px-4 py-2.5 rounded-lg
                    text-slate-400 hover:bg-indigo-600
                    hover:text-white">

                    Ventas

                </a>

                <a href="/Proveedor/Index"
                   class="block px-4 py-2.5 rounded-lg
                    text-slate-400 hover:bg-indigo-600
                    hover:text-white">

                    Proveedores

                </a>

                <a href="/CompraProveedor/Index"
                   class="block px-4 py-2.5 rounded-lg
                    bg-indigo-600 text-white">

                    Compras a proveedores

                </a>

            </nav>

        </aside>


        <!-- CONTENIDO -->

        <main class="flex-1 p-6">

            <div class="max-w-7xl mx-auto">


                <!-- ENCABEZADO -->

                <div class="flex flex-col md:flex-row
                    md:items-center
                    md:justify-between mb-6">

                    <div>

                        <h1 class="text-2xl font-bold text-slate-900">

                            Compra #@Model.IdCompra

                        </h1>

                        <p class="text-slate-500 mt-1">

                            Detalle de la compra al proveedor

                        </p>

                    </div>


                    <div class="flex gap-2 mt-4 md:mt-0">

                        <a href="/CompraProveedor/Index"
                           class="px-4 py-2 rounded-lg
                            border border-slate-300
                            text-slate-700
                            hover:bg-slate-100">

                            Volver

                        </a>


                        @if (Model.Estado != "Recibida" &&
                             Model.Estado != "Cancelada")
                        {
                            <a href="/CompraProveedor/Edit/@Model.IdCompra"
                               class="px-4 py-2 rounded-lg
                                bg-indigo-600 text-white
                                hover:bg-indigo-700">

                                Editar

                            </a>
                        }

                    </div>

                </div>


                <!-- MENSAJES -->
                @if (TempData["Success"] != null)
                {
                    <div class="mb-5 bg-green-50
                        border border-green-200
                        text-green-700
                        px-4 py-3 rounded-lg">

                        @TempData["Success"]

                    </div>
                }


                @if (TempData["Error"] != null)
                {
                    <div class="mb-5 bg-red-50
                        border border-red-200
                        text-red-700
                        px-4 py-3 rounded-lg">

                        @TempData["Error"]

                    </div>
                }


                <!-- INFORMACIÓN GENERAL -->

                <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-6">


                    <div class="bg-white rounded-xl shadow-sm
                        border border-slate-200 p-5">

                        <p class="text-sm text-slate-500">
                            Proveedor
                        </p>

                        <p class="text-lg font-bold text-slate-900 mt-1">

                            @Model.IdProveedorNavigation?.Nombre

                        </p>

                    </div>


                    <div class="bg-white rounded-xl shadow-sm
                        border border-slate-200 p-5">

                        <p class="text-sm text-slate-500">
                            Fecha
                        </p>

                        <p class="text-lg font-bold text-slate-900 mt-1">

                            @Model.FechaCompra.ToString("dd/MM/yyyy")

                        </p>

                    </div>


                    <div class="bg-white rounded-xl shadow-sm
                        border border-slate-200 p-5">

                        <p class="text-sm text-slate-500">
                            Estado
                        </p>

                        @if (Model.Estado == "Recibida")
                        {
                            <span class="inline-block mt-2
                                px-3 py-1 rounded-full
                                bg-green-100 text-green-700
                                font-semibold">

                                Recibida

                            </span>
                        }
                        else if (Model.Estado == "Cancelada")
                        {
                            <span class="inline-block mt-2
                                px-3 py-1 rounded-full
                                bg-red-100 text-red-700
                                font-semibold">

                                Cancelada

                            </span>
                        }
                        else if (Model.Estado == "En proceso")
                        {
                            <span class="inline-block mt-2
                                px-3 py-1 rounded-full
                                bg-blue-100 text-blue-700
                                font-semibold">

                                En proceso

                            </span>
                        }
                        else
                        {
                            <span class="inline-block mt-2
                                px-3 py-1 rounded-full
                                bg-yellow-100 text-yellow-700
                                font-semibold">

                                Pendiente

                            </span>
                        }

                    </div>

                </div>


                <!-- PRODUCTOS -->

                <div class="bg-white rounded-xl shadow-sm
                    border border-slate-200 overflow-hidden">

                    <div class="p-5 border-b
                        border-slate-200
                        flex justify-between items-center">

                        <div>

                            <h2 class="text-lg font-bold text-slate-900">

                                Productos de la compra

                            </h2>

                            <p class="text-sm text-slate-500">

                                @detalles.Count() producto(s)

                            </p>

                        </div>


                        @if (Model.Estado != "Recibida" &&
                             Model.Estado != "Cancelada")
                        {
                            <a href="/CompraProveedor/AgregarDetalle/@Model.IdCompra"
                               class="px-4 py-2 rounded-lg
                                bg-indigo-600 text-white
                                hover:bg-indigo-700">

                                + Agregar producto

                            </a>
                        }

                    </div>


                    <div class="overflow-x-auto">

                        <table class="w-full text-sm text-left">

                            <thead class="bg-slate-50
                                border-b border-slate-200">

                                <tr>

                                    <th class="px-5 py-4">
                                        Producto
                                    </th>

                                    <th class="px-5 py-4">
                                        Cantidad
                                    </th>

                                    <th class="px-5 py-4">
                                        Precio compra
                                    </th>

                                    <th class="px-5 py-4">
                                        Subtotal
                                    </th>

                                </tr>

                            </thead>


                            <tbody class="divide-y
                                divide-slate-100">

                                @if (detalles.Any())
                                {
                                    foreach (var detalle in detalles)
                                    {
                                        <tr class="hover:bg-slate-50">

                                            <td class="px-5 py-4
                                                font-semibold">

                                                @detalle.IdProductoNavigation?.Nombre

                                            </td>

                                            <td class="px-5 py-4">

                                                @detalle.Cantidad

                                            </td>

                                            <td class="px-5 py-4">

                                                ₡@detalle.PrecioCompra.ToString("N2")

                                            </td>

                                            <td class="px-5 py-4
                                                font-semibold">

                                                ₡@detalle.Subtotal.ToString("N2")

                                            </td>

                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>

                                        <td colspan="4"
                                            class="px-5 py-10
                                            text-center
                                            text-slate-500">

                                            Esta compra no tiene productos.

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>


                    <!-- TOTAL -->

                    <div class="border-t border-slate-200
                        p-5 flex justify-end">

                        <div class="text-right">

                            <p class="text-sm text-slate-500">
                                Total de la compra
                            </p>

                            <p class="text-2xl font-bold
                                text-slate-900">

                                ₡@((Model.Total ?? 0).ToString("N2"))

                            </p>

                        </div>

                    </div>

                </div>


                @if (Model.Estado != "Recibida" && Model.Estado != "Cancelada")
                {
                    <div class="mt-6 bg-white rounded-xl
                        shadow-sm border border-slate-200 p-5">

                        <h2 class="font-bold text-slate-900 mb-1">
                            Actualizar estado
                        </h2>

                        <p class="text-sm text-slate-500 mb-4">
                            Al marcar la compra como
                            <strong>Recibida</strong>, el stock de los
                            productos será actualizado automáticamente.
                        </p>


                        <div class="flex flex-wrap gap-3">

                            <!-- EN PROCESO -->

                            <form action="/CompraProveedor/CambiarEstado"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@Model.IdCompra" />

                                <input type="hidden"
                                       name="estado"
                                       value="En proceso" />

                                <button type="submit"
                                        class="px-4 py-2 rounded-lg
                                    bg-blue-600 text-white
                                    hover:bg-blue-700 transition">

                                    En proceso

                                </button>

                            </form>


                            <!-- RECIBIDA -->

                            <form action="/CompraProveedor/CambiarEstado"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@Model.IdCompra" />

                                <input type="hidden"
                                       name="estado"
                                       value="Recibida" />

                                <button type="submit"
                                        class="px-4 py-2 rounded-lg
                                    bg-green-600 text-white
                                    hover:bg-green-700 transition">

                                    Marcar como recibida

                                </button>

                            </form>


                            <!-- CANCELADA -->

                            <form action="/CompraProveedor/CambiarEstado"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@Model.IdCompra" />

                                <input type="hidden"
                                       name="estado"
                                       value="Cancelada" />

                                <button type="submit"
                                        class="px-4 py-2 rounded-lg
                                    bg-red-600 text-white
                                    hover:bg-red-700 transition">

                                    Cancelar compra

                                </button>

                            </form>

                        </div>

                    </div>
                }

            </div>

        </main>

    </div>

</body>

</html>

