@model TechStore.Models.CompraProveedor

@{
    ViewData["Title"] = "Editar compra a proveedor";
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Editar compra - TechStore</title>

    <script src="https://cdn.tailwindcss.com"></script>

</head>


<body class="bg-slate-100 min-h-screen">

    <div class="min-h-screen flex flex-col md:flex-row">


        <!-- ===================================================== -->
        <!-- SIDEBAR -->
        <!-- ===================================================== -->

        <aside class="w-full md:w-64 bg-slate-900 text-white p-5 shrink-0">

            <!-- LOGO -->

            <div class="flex items-center gap-3 mb-8">

                <div class="w-8 h-8 bg-indigo-500 rounded-lg
                    flex items-center justify-center
                    font-bold">

                    TS

                </div>

                <span class="font-bold text-lg">
                    TechStore Admin
                </span>

            </div>


            <!-- MENU -->

            <nav class="space-y-1">


                <a href="/Admin/Dashboard"
                   class="block px-4 py-2.5 rounded-lg
                    text-slate-400
                    hover:bg-indigo-600
                    hover:text-white
                    transition">

                    Dashboard

                </a>


                <a href="/Proveedor/Index"
                   class="block px-4 py-2.5 rounded-lg
                    text-slate-400
                    hover:bg-indigo-600
                    hover:text-white
                    transition">

                    Proveedores

                </a>


                <a href="/CompraProveedor/Index"
                   class="block px-4 py-2.5 rounded-lg
                    bg-indigo-600
                    text-white">

                    Compras a proveedores

                </a>


                <a href="/Producto/Index"
                   class="block px-4 py-2.5 rounded-lg
                    text-slate-400
                    hover:bg-indigo-600
                    hover:text-white
                    transition">

                    Productos

                </a>


                <a href="/Venta/Index"
                   class="block px-4 py-2.5 rounded-lg
                    text-slate-400
                    hover:bg-indigo-600
                    hover:text-white
                    transition">

                    Ventas

                </a>


            </nav>

        </aside>



        <!-- ===================================================== -->
        <!-- CONTENIDO PRINCIPAL -->
        <!-- ===================================================== -->

        <main class="flex-1 p-6">

            <div class="max-w-4xl mx-auto">


                <!-- ================================================= -->
                <!-- ENCABEZADO -->
                <!-- ================================================= -->

                <div class="mb-8">

                    <h1 class="text-3xl font-bold text-slate-900">

                        Editar compra

                    </h1>


                    <p class="text-slate-500 mt-1">

                        Modifica la información de la compra
                        realizada al proveedor.

                    </p>

                </div>



                <!-- ================================================= -->
                <!-- ERROR -->
                <!-- ================================================= -->
                @if (TempData["Error"] != null)
                {

                    <div class="mb-6 p-4 rounded-lg
                        bg-red-50
                        border border-red-200
                        text-red-700">

                        @TempData["Error"]

                    </div>

                }



                <!-- ================================================= -->
                <!-- ÉXITO -->
                <!-- ================================================= -->
                @if (TempData["Success"] != null)
                {

                    <div class="mb-6 p-4 rounded-lg
                        bg-green-50
                        border border-green-200
                        text-green-700">

                        @TempData["Success"]

                    </div>

                }



                <!-- ================================================= -->
                <!-- FORMULARIO -->
                <!-- ================================================= -->

                <div class="bg-white rounded-xl
                    shadow-sm
                    border border-slate-200
                    p-6">


                    <form action="/CompraProveedor/Edit/@Model.IdCompra"
                          method="post">


                        @Html.AntiForgeryToken()



                        <!-- ================================================= -->
                        <!-- ID DE COMPRA -->
                        <!-- ================================================= -->

                        <input type="hidden"
                               name="IdCompra"
                               value="@Model.IdCompra" />



                        <!-- ================================================= -->
                        <!-- ERRORES DE VALIDACIÓN -->
                        <!-- ================================================= -->
                        @if (!ViewData.ModelState.IsValid)
                        {

                            <div class="mb-6 p-4 rounded-lg
                                bg-red-50
                                border border-red-200
                                text-red-700">

                                <p class="font-semibold mb-2">

                                    No se pudieron guardar los cambios:

                                </p>


                                <ul class="list-disc ml-5">

                                    @foreach (var error in ViewData.ModelState.Values
                                        .SelectMany(v => v.Errors))
                                    {

                                        <li>

                                            @if (!string.IsNullOrEmpty(error.ErrorMessage))
                                            {
                                                @error.ErrorMessage
                                            }
                                            else
                                            {
                                                @error.Exception?.Message
                                            }

                                        </li>

                                    }

                                </ul>

                            </div>

                        }



                        <!-- ================================================= -->
                        <!-- PROVEEDOR -->
                        <!-- ================================================= -->

                        <div class="mb-5">

                            <label for="IdProveedor"
                                   class="block text-sm font-semibold text-slate-700 mb-2">
                                Proveedor
                            </label>

                            <select id="IdProveedor"
                                    name="IdProveedor"
                                    required
                                    class="w-full px-4 py-3
                                border border-slate-300
                                rounded-lg
                                focus:ring-2
                                focus:ring-indigo-500
                                outline-none">

                                <option value="">
                                    Seleccione un proveedor
                                </option>

                                @if (ViewBag.IdProveedor != null)
                                {
                                    foreach (var proveedor in ViewBag.IdProveedor)
                                    {
                                        <option value="@proveedor.Value">
                                            @proveedor.Text
                                        </option>
                                    }
                                }

                            </select>

                        </div>




                        <!-- ================================================= -->
                        <!-- PRODUCTO -->
                        <!-- ================================================= -->

                        <div class="mb-5">


                            <label for="IdProducto"
                                   class="block text-sm
                                font-semibold
                                text-slate-700
                                mb-2">

                                Producto

                            </label>



                            <select id="IdProducto"
                                    name="IdProducto"
                                    class="w-full px-4 py-3
                                border border-slate-300
                                rounded-lg
                                bg-white
                                focus:ring-2
                                focus:ring-indigo-500
                                outline-none">


                                <option value="">

                                    Seleccione un producto

                                </option>



                                @if (ViewBag.Productos != null)
                                {

                                    foreach (var producto in ViewBag.Productos)
                                    {

                                        <option value="@producto.IdProducto">

                                            @producto.Nombre

                                        </option>

                                    }

                                }

                            </select>

                        </div>



                        <!-- ================================================= -->
                        <!-- FECHA -->
                        <!-- ================================================= -->

                        <div class="mb-6">


                            <label for="FechaCompra"
                                   class="block text-sm
                                font-semibold
                                text-slate-700
                                mb-2">

                                Fecha de compra

                            </label>



                            <input type="datetime-local"
                                   id="FechaCompra"
                                   name="FechaCompra"
                                   value="@Model.FechaCompra.ToString("yyyy-MM-ddTHH:mm")"
                                   class="w-full px-4 py-3
                            border border-slate-300
                            rounded-lg
                            focus:ring-2
                            focus:ring-indigo-500
                            outline-none" />

                        </div>



                        <!-- ================================================= -->
                        <!-- TOTAL -->
                        <!-- ================================================= -->

                        <div class="mb-6">


                            <label for="Total"
                                   class="block text-sm
                                font-semibold
                                text-slate-700
                                mb-2">

                                Total

                            </label>



                            <input type="number"
                                   id="Total"
                                   name="Total"
                                   value="@Model.Total"
                                   step="0.01"
                                   readonly
                                   class="w-full px-4 py-3
                            border border-slate-300
                            rounded-lg
                            bg-slate-100
                            text-slate-600
                            outline-none" />



                            <p class="text-xs text-slate-400 mt-2">

                                El total se calcula automáticamente
                                a partir de los productos agregados.

                            </p>

                        </div>



                        <!-- ================================================= -->
                        <!-- ESTADO -->
                        <!-- ================================================= -->

                        <div class="mb-6">


                            <label for="Estado"
                                   class="block text-sm
                                font-semibold
                                text-slate-700
                                mb-2">

                                Estado

                            </label>



                            <select id="Estado"
                                    name="Estado"
                                    required
                                    class="w-full px-4 py-3
                                border border-slate-300
                                rounded-lg
                                bg-white
                                focus:ring-2
                                focus:ring-indigo-500
                                outline-none">


                                @if (Model.Estado == "Pendiente")
                                {

                                    <option value="Pendiente"
                                            selected>

                                        Pendiente

                                    </option>

                                }
                                else
                                {

                                    <option value="Pendiente">

                                        Pendiente

                                    </option>

                                }



                                @if (Model.Estado == "Recibida")
                                {

                                    <option value="Recibida"
                                            selected>

                                        Recibida

                                    </option>

                                }
                                else
                                {

                                    <option value="Recibida">

                                        Recibida

                                    </option>

                                }



                                @if (Model.Estado == "Cancelada")
                                {

                                    <option value="Cancelada"
                                            selected>

                                        Cancelada

                                    </option>

                                }
                                else
                                {

                                    <option value="Cancelada">

                                        Cancelada

                                    </option>

                                }

                            </select>



                            <p class="text-xs text-slate-400 mt-2">

                                Al cambiar a "Recibida", el inventario
                                será actualizado automáticamente.

                            </p>

                        </div>



                        <!-- ================================================= -->
                        <!-- BOTONES -->
                        <!-- ================================================= -->

                        <div class="flex flex-col
                            sm:flex-row
                            justify-between
                            gap-3
                            pt-4
                            border-t
                            border-slate-200">


                            <!-- VOLVER -->

                            <a href="/CompraProveedor/Index"
                               class="px-5 py-3
                                rounded-lg
                                border border-slate-300
                                text-slate-700
                                text-center
                                hover:bg-slate-100
                                transition">

                                ← Volver al índice

                            </a>



                            <!-- GUARDAR -->

                            <button type="submit"
                                    class="px-5 py-3
                                rounded-lg
                                bg-indigo-600
                                text-white
                                font-medium
                                hover:bg-indigo-700
                                transition">

                                Guardar cambios

                            </button>


                        </div>


                    </form>

                </div>

            </div>

        </main>

    </div>

</body>

</html>


