@model TechStore.Models.CompraProveedor

@{
    ViewData["Title"] = "Editar compra a proveedor";
}

<!DOCTYPE html>

<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Editar compra - TechStore</title>

    <script src="https://cdn.tailwindcss.com"></script>

</head>

<body class="bg-slate-100 min-h-screen">

    <div class="min-h-screen flex flex-col md:flex-row">

        <!-- ===================================================== -->
        <!-- SIDEBAR -->
        <!-- ===================================================== -->

        <aside class="w-full md:w-64 bg-slate-900 text-white p-5 shrink-0">

            <div class="flex items-center gap-3 mb-8">

                <div class="w-8 h-8 bg-indigo-500 rounded-lg
                    flex items-center justify-center
                    font-bold">

                    TS

                </div>

                <span class="font-bold text-lg">
                    TechStore Admin
                </span>

            </div>


            <nav class="space-y-1">

                <a href="/Admin/Dashboard"
                   class="block px-4 py-2.5 rounded-lg
                    text-slate-400
                    hover:bg-indigo-600
                    hover:text-white
                    transition">

                    Dashboard

                </a>


                <a href="/Proveedor/Index"
                   class="block px-4 py-2.5 rounded-lg
                    bg-indigo-600 text-white">

                    Proveedores

                </a>


                <a href="/CompraProveedor/Index"
                   class="block px-4 py-2.5 rounded-lg
                    text-slate-400
                    hover:bg-indigo-600
                    hover:text-white
                    transition">

                    Compras a proveedores

                </a>


                <a href="/Producto/Index"
                   class="block px-4 py-2.5 rounded-lg
                    text-slate-400
                    hover:bg-indigo-600
                    hover:text-white
                    transition">

                    Productos

                </a>


                <a href="/Venta/Index"
                   class="block px-4 py-2.5 rounded-lg
                    text-slate-400
                    hover:bg-indigo-600
                    hover:text-white
                    transition">

                    Ventas

                </a>

            </nav>

        </aside>


        <!-- ===================================================== -->
        <!-- CONTENIDO -->
        <!-- ===================================================== -->

        <main class="flex-1 p-6">

            <div class="max-w-4xl mx-auto">


                <!-- ENCABEZADO -->

                <div class="mb-8">

                    <h1 class="text-3xl font-bold text-slate-900">

                        Editar compra

                    </h1>

                    <p class="text-slate-500 mt-1">

                        Modifica la información de la compra
                        realizada al proveedor.

                    </p>

                </div>


                <!-- ERRORES -->
                @if (TempData["Error"] != null)
                {

                    <div class="mb-6 p-4 rounded-lg
                        bg-red-50
                        border border-red-200
                        text-red-700">

                        @TempData["Error"]

                    </div>

                }


                <!-- FORMULARIO -->

                <div class="bg-white rounded-xl
                    shadow-sm
                    border border-slate-200
                    p-6">

                    <form asp-action="Edit"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="IdCompra" />


                        <!-- VALIDACIONES -->

                        <div asp-validation-summary="ModelOnly"
                             class="mb-6 text-red-600">
                        </div>


                        <!-- PROVEEDOR -->

                        <div class="mb-6">

                            <label asp-for="IdProveedor"
                                   class="block text-sm
                                font-semibold
                                text-slate-700
                                mb-2">

                                Proveedor

                            </label>

                            <select asp-for="IdProveedor"
                                    asp-items="ViewBag.IdProveedor"
                                    class="w-full px-4 py-3
                                border
                                border-slate-300
                                rounded-lg
                                bg-white
                                focus:ring-2
                                focus:ring-indigo-500
                                outline-none">

                                <option value="">
                                    Seleccione un proveedor
                                </option>

                            </select>

                            <span asp-validation-for="IdProveedor"
                                  class="text-sm text-red-600">
                            </span>

                        </div>


                        <!-- FECHA -->

                        <div class="mb-6">

                            <label asp-for="FechaCompra"
                                   class="block text-sm
                                font-semibold
                                text-slate-700
                                mb-2">

                                Fecha de compra

                            </label>

                            <input asp-for="FechaCompra"
                                   type="datetime-local"
                                   class="w-full px-4 py-3
                            border
                            border-slate-300
                            rounded-lg
                            focus:ring-2
                            focus:ring-indigo-500
                            outline-none" />

                            <span asp-validation-for="FechaCompra"
                                  class="text-sm text-red-600">
                            </span>

                        </div>


                        <!-- TOTAL -->

                        <div class="mb-6">

                            <label asp-for="Total"
                                   class="block text-sm
                                font-semibold
                                text-slate-700
                                mb-2">

                                Total

                            </label>

                            <input asp-for="Total"
                                   type="number"
                                   step="0.01"
                                   readonly
                                   class="w-full px-4 py-3
                            border
                            border-slate-300
                            rounded-lg
                            bg-slate-100
                            text-slate-600
                            outline-none" />

                            <p class="text-xs text-slate-400 mt-2">

                                El total se calcula automáticamente
                                a partir de los productos agregados.

                            </p>

                        </div>


                        <!-- ESTADO -->

                        <div class="mb-6">

                            <label asp-for="Estado"
                                   class="block text-sm
                                font-semibold
                                text-slate-700
                                mb-2">

                                Estado

                            </label>

                            <select asp-for="Estado"
                                    class="w-full px-4 py-3
                                border
                                border-slate-300
                                rounded-lg
                                bg-white
                                focus:ring-2
                                focus:ring-indigo-500
                                outline-none">

                                <option value="Pendiente">
                                    Pendiente
                                </option>

                                <option value="En proceso">
                                    En proceso
                                </option>

                                <option value="Recibida">
                                    Recibida
                                </option>

                                <option value="Cancelada">
                                    Cancelada
                                </option>

                            </select>

                            <p class="text-xs text-slate-400 mt-2">

                                Al cambiar a "Recibida", el inventario
                                será actualizado automáticamente.

                            </p>

                            <span asp-validation-for="Estado"
                                  class="text-sm text-red-600">
                            </span>

                        </div>


                        <!-- BOTONES -->

                        <div class="flex flex-col
                            sm:flex-row
                            justify-between
                            gap-3
                            pt-4
                            border-t
                            border-slate-200">


                            <a href="/CompraProveedor/Details/@Model.IdCompra"
                               class="px-5 py-3
                                rounded-lg
                                border
                                border-slate-300
                                text-slate-700
                                text-center
                                hover:bg-slate-100
                                transition">

                                Ver detalles

                            </a>


                            <div class="flex gap-3">


                                <a href="/CompraProveedor/Index"
                                   class="px-5 py-3
                                    rounded-lg
                                    border
                                    border-slate-300
                                    text-slate-700
                                    hover:bg-slate-100
                                    transition">

                                    Cancelar

                                </a>


                                <button type="submit"
                                        class="px-5 py-3
                                    rounded-lg
                                    bg-indigo-600
                                    text-white
                                    font-medium
                                    hover:bg-indigo-700
                                    transition">

                                    Guardar cambios

                                </button>

                            </div>

                        </div>

                    </form>

                </div>

            </div>

        </main>

    </div>


    <!-- VALIDACIONES -->

    <partial name="_ValidationScriptsPartial" />

</body>

</html>
