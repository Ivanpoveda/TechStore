@model TechStore.Models.Garantium

@{
    ViewData["Title"] = "Nueva Garantía";
}

<meta charset="utf-8" />

<title>Nueva Garantía - TechStore</title>

<script src="https://cdn.tailwindcss.com"></script>

<div class="min-h-screen flex flex-col md:flex-row">

    <!-- SIDEBAR -->

    <aside class="w-full md:w-64 bg-slate-900 text-white p-5 shrink-0">

        <div class="flex items-center gap-3 mb-8">

            <div class="w-8 h-8 bg-indigo-500 rounded-lg
                flex items-center justify-center font-bold">
                TS
            </div>

            <span class="font-bold text-lg">
                TechStore Admin
            </span>

        </div>

        <nav class="space-y-1">

            <a href="/Admin/Dashboard"
               class="block px-4 py-2.5 rounded-lg
                text-slate-400 hover:bg-indigo-600
                hover:text-white transition">
                Dashboard
            </a>

            <a href="/Usuario/Index"
               class="block px-4 py-2.5 rounded-lg
                text-slate-400 hover:bg-indigo-600
                hover:text-white transition">
                Usuarios
            </a>

            <a href="/Producto/Index"
               class="block px-4 py-2.5 rounded-lg
                text-slate-400 hover:bg-indigo-600
                hover:text-white transition">
                Productos
            </a>

            <a href="/Venta/Index"
               class="block px-4 py-2.5 rounded-lg
                text-slate-400 hover:bg-indigo-600
                hover:text-white transition">
                Ventas
            </a>

            <a href="/Garantia/Index"
               class="block px-4 py-2.5 rounded-lg
                bg-indigo-600 text-white">
                Garantías
            </a>

            <a href="/Proveedor/Index"
               class="block px-4 py-2.5 rounded-lg
                text-slate-400 hover:bg-indigo-600
                hover:text-white transition">
                Proveedores
            </a>

        </nav>

    </aside>


    <!-- CONTENIDO -->

    <main class="flex-1 p-6">

        <div class="max-w-2xl mx-auto">

            <div class="bg-white rounded-xl shadow p-6">

                <h1 class="text-2xl font-bold text-slate-900">
                    Nueva Garantía
                </h1>

                <p class="text-slate-500 mt-1 mb-6">
                    Registra una solicitud de garantía.
                </p>


                @if (TempData["Error"] != null)
                {
                    <div class="mb-5 bg-red-50 border border-red-200
                        text-red-700 px-4 py-3 rounded-lg">

                        @TempData["Error"]

                    </div>
                }


                <form asp-action="Create"
                      method="post">

                    @Html.AntiForgeryToken()


                    <!-- DETALLE -->

                    <div class="mb-5">

                        <label class="block font-semibold
                            text-slate-700 mb-2">

                            Producto / Venta

                        </label>

                        <select name="IdDetalleVenta"
                                required
                                class="w-full border border-slate-300
                            rounded-lg px-3 py-2.5">

                            <option value="">
                                -- Seleccione un producto --
                            </option>

                            @foreach (var detalle in ViewBag.DetallesVenta)
                            {
                                var seleccionado =
                                    Model.IdDetalleVenta ==
                                    detalle.IdDetalleVenta;

                                <option value="@detalle.IdDetalleVenta"
                                        selected="@seleccionado">

                                    Venta #@detalle.IdVenta
                                    -
                                    @detalle.IdProductoNavigation?.Nombre

                                </option>
                            }

                        </select>

                    </div>


                    <!-- MOTIVO -->

                    <div class="mb-5">

                        <label class="block font-semibold
                            text-slate-700 mb-2">

                            Motivo

                        </label>

                        <input type="text"
                               name="Motivo"
                               value="@Model.Motivo"
                               maxlength="200"
                               required
                               placeholder="Ej: Producto defectuoso"
                               class="w-full border border-slate-300
                        rounded-lg px-3 py-2.5
                        focus:ring-2 focus:ring-indigo-500
                        focus:outline-none" />

                    </div>


                    <!-- DESCRIPCIÓN -->

                    <div class="mb-5">

                        <label class="block font-semibold
                            text-slate-700 mb-2">

                            Descripción

                        </label>

                        <textarea name="Descripcion"
                                  rows="5"
                                  maxlength="500"
                                  required
                                  placeholder="Describe detalladamente el problema..."
                                  class="w-full border border-slate-300
                        rounded-lg px-3 py-2.5
                        focus:ring-2 focus:ring-indigo-500
                        focus:outline-none">@Model.Descripcion</textarea>

                    </div>


                    <!-- INFORMACIÓN -->

                    <div class="bg-yellow-50 border border-yellow-200
                        text-yellow-800 px-4 py-3 rounded-lg
                        mb-6 text-sm">

                        <strong>Estado inicial:</strong>
                        En proceso.

                        <br />

                        La solicitud será revisada por el administrador.

                    </div>


                    <!-- BOTONES -->

                    <div class="flex justify-end gap-3">

                        <a href="/Garantia/Index"
                           class="px-5 py-2.5 rounded-lg
                            border border-slate-300
                            text-slate-600
                            hover:bg-slate-100 transition">

                            Cancelar

                        </a>

                        <button type="submit"
                                class="bg-indigo-600 text-white
                            px-5 py-2.5 rounded-lg shadow
                            hover:bg-indigo-700 transition">

                            Registrar Garantía

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </main>

</div>