@model IEnumerable<TechStore.Models.Garantium>

@{
    ViewData["Title"] = "Garantías";
}

<meta charset="utf-8" />

<title>Garantías - TechStore</title>

<script src="https://cdn.tailwindcss.com"></script>

<div class="min-h-screen bg-slate-100 flex flex-col md:flex-row">

    <!-- SIDEBAR -->

    <aside class="w-full md:w-64 bg-slate-900 text-white p-5 flex flex-col justify-between shrink-0">

        <div>

            <div class="flex items-center gap-3 mb-8">
                <div class="w-8 h-8 bg-indigo-500 rounded-lg flex items-center justify-center font-bold">
                    TS
                </div>

                <span class="font-bold text-lg tracking-wide">
                    TechStore Admin
                </span>
            </div>

            <nav class="space-y-1">

                <a href="/Admin/Dashboard"
                   class="flex items-center gap-3 px-4 py-2.5 rounded-lg transition
                    text-slate-400 hover:bg-indigo-600 hover:text-white hover:scale-105">
                    Dashboard
                </a>

                <a href="/Usuario/Index"
                   class="flex items-center gap-3 px-4 py-2.5 rounded-lg transition
                    text-slate-400 hover:bg-indigo-600 hover:text-white hover:scale-105">
                    Usuarios
                </a>

                <a href="/Producto/Index"
                   class="flex items-center gap-3 px-4 py-2.5 rounded-lg transition
                    text-slate-400 hover:bg-indigo-600 hover:text-white hover:scale-105">
                    Productos
                </a>

                <a href="/Venta/Index"
                   class="flex items-center gap-3 px-4 py-2.5 rounded-lg transition
                    text-slate-400 hover:bg-indigo-600 hover:text-white hover:scale-105">
                    Ventas
                </a>

                <a href="/Garantia/Index"
                   class="flex items-center gap-3 px-4 py-2.5 rounded-lg transition
                    bg-indigo-600 text-white font-medium">
                    Garantias
                </a>

                <a href="/Proveedor/Index"
                   class="flex items-center gap-3 px-4 py-2.5 rounded-lg transition
                    text-slate-400 hover:bg-indigo-600 hover:text-white hover:scale-105">
                    Proveedores
                </a>

            </nav>

        </div>

        <div class="border-t border-slate-700 pt-4 mt-6">

            <form action="/Account/Logout"
                  method="post">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="w-full flex items-center gap-3
                    px-4 py-2.5 rounded-lg
                    text-slate-400
                    hover:bg-red-600
                    hover:text-white
                    transition">

                    <span class="text-lg">
                        ⇥
                    </span>

                    <span>
                        Cerrar sesión
                    </span>

                </button>

            </form>

        </div>

    </aside>

    <!-- CONTENIDO -->

    <main class="flex-1 p-6">

        <div class="max-w-7xl mx-auto">

            <!-- ENCABEZADO -->

            <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-6">

                <div>
                    <h1 class="text-2xl font-bold text-slate-900">
                        Garantías
                    </h1>

                    <p class="text-slate-500 mt-1">
                        Gestión de garantías de los productos vendidos.
                    </p>
                </div>

                <a href="/Garantia/Create"
                   class="mt-4 md:mt-0 inline-flex items-center justify-center
                    bg-indigo-600 text-white px-5 py-2.5 rounded-lg
                    shadow hover:bg-indigo-700 transition">

                    + Nueva Garantía

                </a>

            </div>


            <!-- MENSAJES -->
            @if (TempData["Success"] != null)
            {
                <div class="mb-5 bg-green-50 border border-green-200
                    text-green-700 px-4 py-3 rounded-lg">

                    @TempData["Success"]

                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="mb-5 bg-red-50 border border-red-200
                    text-red-700 px-4 py-3 rounded-lg">

                    @TempData["Error"]

                </div>
            }


            <!-- TABLA -->

            <div class="bg-white rounded-xl shadow overflow-hidden">

                <div class="overflow-x-auto">

                    <table class="w-full text-sm text-left">

                        <thead class="bg-slate-50 border-b border-slate-200">

                            <tr>

                                <th class="px-5 py-4 font-semibold text-slate-700">
                                    ID
                                </th>

                                <th class="px-5 py-4 font-semibold text-slate-700">
                                    Producto
                                </th>

                                <th class="px-5 py-4 font-semibold text-slate-700">
                                    Cliente
                                </th>

                                <th class="px-5 py-4 font-semibold text-slate-700">
                                    Fecha
                                </th>

                                <th class="px-5 py-4 font-semibold text-slate-700">
                                    Motivo
                                </th>

                                <th class="px-5 py-4 font-semibold text-slate-700">
                                    Estado
                                </th>

                                <th class="px-5 py-4 font-semibold text-slate-700 text-center">
                                    Acciones
                                </th>

                            </tr>

                        </thead>


                        <tbody class="divide-y divide-slate-100">

                            @if (Model != null && Model.Any())
                            {

                                foreach (var garantia in Model)
                                {
                                    var detalle = garantia.IdDetalleVentaNavigation;

                                    <tr class="hover:bg-slate-50 transition">

                                        <!-- ID -->

                                        <td class="px-5 py-4 font-semibold text-slate-900">

                                            #@garantia.IdGarantia

                                        </td>


                                        <!-- PRODUCTO -->

                                        <td class="px-5 py-4 text-slate-700">

                                            @(detalle?.IdProductoNavigation?.Nombre ?? "Sin producto")

                                        </td>


                                        <!-- CLIENTE -->

                                        <td class="px-5 py-4 text-slate-700">

                                            @{
                                                var usuario =
                                                    detalle?.IdVentaNavigation?.IdUsuarioNavigation;
                                            }

                                            @if (usuario != null)
                                            {
                                                @($"{usuario.Nombre} {usuario.Apellidos}")
                                            }
                                            else
                                            {
                                                <span class="text-slate-400">
                                                    Sin cliente
                                                </span>
                                            }

                                        </td>


                                        <!-- FECHA -->

                                        <td class="px-5 py-4 text-slate-600">

                                            @garantia.FechaSolicitud.ToString("dd-MM-yyyy")

                                        </td>


                                        <!-- MOTIVO -->

                                        <td class="px-5 py-4 text-slate-700">

                                            @(garantia.Motivo ?? "Sin motivo")

                                        </td>


                                        <!-- ESTADO -->

                                        <td class="px-5 py-4">

                                            @if (garantia.Estado == "En proceso")
                                            {
                                                <span class="inline-flex px-3 py-1 rounded-full
                                                    text-xs font-semibold
                                                    bg-yellow-100 text-yellow-700">

                                                    En proceso

                                                </span>
                                            }
                                            else if (garantia.Estado == "Aprobada")
                                            {
                                                <span class="inline-flex px-3 py-1 rounded-full
                                                    text-xs font-semibold
                                                    bg-green-100 text-green-700">

                                                    Aprobada

                                                </span>
                                            }
                                            else if (garantia.Estado == "Rechazada")
                                            {
                                                <span class="inline-flex px-3 py-1 rounded-full
                                                    text-xs font-semibold
                                                    bg-red-100 text-red-700">

                                                    Rechazada

                                                </span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex px-3 py-1 rounded-full
                                                    text-xs font-semibold
                                                    bg-slate-100 text-slate-700">

                                                    @garantia.Estado

                                                </span>
                                            }

                                        </td>


                                        <!-- ACCIONES -->

                                        <td class="px-5 py-4">

                                            <div class="flex justify-center gap-2">

                                                <a href="/Garantia/Details/@garantia.IdGarantia"
                                                   class="px-3 py-1.5 rounded-lg
                                                    bg-slate-100 text-slate-700
                                                    hover:bg-slate-200 transition">

                                                    Ver

                                                </a>

                                                <a href="/Garantia/Edit/@garantia.IdGarantia"
                                                   class="px-3 py-1.5 rounded-lg
                                                    bg-indigo-50 text-indigo-600
                                                    hover:bg-indigo-100 transition">

                                                    Editar

                                                </a>

                                                <a href="/Garantia/Delete/@garantia.IdGarantia"
                                                   class="px-3 py-1.5 rounded-lg
                                                    bg-red-50 text-red-600
                                                    hover:bg-red-100 transition">

                                                    Eliminar

                                                </a>

                                            </div>

                                        </td>

                                    </tr>
                                }

                            }
                            else
                            {

                                <tr>

                                    <td colspan="7"
                                        class="px-5 py-10 text-center">

                                        <div class="text-slate-400">

                                            <p class="text-lg font-semibold">
                                                No hay garantías registradas
                                            </p>

                                            <p class="text-sm mt-1">
                                                Actualmente no existen solicitudes de garantía.
                                            </p>

                                        </div>

                                    </td>

                                </tr>

                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </main>

</div>