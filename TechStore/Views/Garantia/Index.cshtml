@model IEnumerable<TechStore.Models.Garantium>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FechaSolicitud)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Motivo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Descripcion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Estado)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FechaResolucion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdDetalleVentaNavigation)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.FechaSolicitud)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Motivo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Descripcion)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Estado)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FechaResolucion)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IdDetalleVentaNavigation.IdDetalleVenta)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdGarantia">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdGarantia">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IdGarantia">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
